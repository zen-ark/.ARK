---
import "@/styles/global.css";
import Header from "./partials/Header.astro";
import Footer from "./partials/FooterV2.astro";
import FooterPortfolio from "./partials/FooterPortfolio.astro";
import { buildOrganizationSchema, buildWebSiteSchema, formatJsonLd } from "@/lib/seo";
import ModeToggle from "@/components/ModeToggle";
import { isHomepageRoute } from "@/lib/mode";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: string;
  canonical?: string;
  ogType?: "website" | "article";
  showFooter?: boolean;
  theme?: "light" | "dark";
  footerMode?: "default" | "reveal";
  headerMode?: "agency" | "hiring";
  wrapperClass?: string;
}

const {
  title = ".ARK — Creative Studio",
  description = "Creative studio — clarity, usability, experimentation",
  ogImage = "/og.jpg",
  lang = "en",
  canonical,
  ogType = "website",
  showFooter = true,
  theme = "light",
  footerMode = "default",
  headerMode,
  wrapperClass = "",
} = Astro.props;

const currentPath = Astro.url.pathname;
const isGerman = currentPath.startsWith("/de");

const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || "ark.studio.ch";
const isProd = import.meta.env.PROD;

const siteUrl = import.meta.env.SITE || "https://ark.studio.ch";
const fullUrl = canonical || new URL(currentPath, siteUrl).toString();

// Schema.org structured data
const organizationSchema = buildOrganizationSchema({
  name: ".ARK",
  url: siteUrl,
  logo: `${siteUrl}/og.jpg`,
  sameAs: [],
});

const websiteSchema = buildWebSiteSchema({
  name: ".ARK",
  url: siteUrl,
  description: "Creative studio focused on clarity, usability, and experimentation",
});
---

<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; object-src 'none'; base-uri 'self'; connect-src 'self' https://plausible.io; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src 'self' https://www.youtube.com https://player.vimeo.com;"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.ico" />
    <link rel="canonical" href={fullUrl} />

    <!-- Geist Variable Font for smooth weight animation -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content=".ARK" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).toString()} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={formatJsonLd(organizationSchema)} />
    <script type="application/ld+json" set:html={formatJsonLd(websiteSchema)} />

    <!-- Plausible Analytics (Production Only) -->
    {
      isProd && (
        <>
          <link rel="preconnect" href="https://plausible.io" />
          <script
            is:inline
            defer
            data-domain={plausibleDomain}
            src="https://plausible.io/js/script.js"
          />
        </>
      )
    }
  </head>
  <body class={`antialiased m-0 p-0 ${footerMode === "reveal" ? "bg-black" : ""}`}>
    {
      footerMode === "reveal" ? (
        <>
          <div
            class={`relative z-10 bg-[#111] ${wrapperClass} min-h-screen mb-0 md:mb-[calc(var(--footer-height)-1px)]`}
          >
            <Header mode={headerMode} />
            <slot />
          </div>

          {isHomepageRoute(currentPath) && (
            <ModeToggle client:load currentPath={currentPath} isGerman={isGerman} />
          )}

          {showFooter && (
            <div class="relative z-0 md:fixed md:bottom-0 md:left-0 md:w-full md:-z-10 md:h-auto">
              <FooterPortfolio />
            </div>
          )}
        </>
      ) : (
        <>
          <Header mode={headerMode} />
          <slot />

          {isHomepageRoute(currentPath) && (
            <ModeToggle client:load currentPath={currentPath} isGerman={isGerman} />
          )}

          {showFooter && <Footer />}
        </>
      )
    }
  </body>
</html>
