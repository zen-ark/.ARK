---
const currentYear = new Date().getFullYear();
---

<footer id="site-footer" class="bg-black text-white">
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20">
    <!-- Main flex container - 3 flexboxes stacked vertically -->
    <div class="flex flex-col">
      <!-- Flexbox 1: Top section - split in 2, aligned horizontally -->
      <!-- Grid created with CSS borders: footer has border-top, row has border-left/right/bottom, columns have border-left -->
      <div class="flex flex-col md:flex-row pb-12 relative row-container" id="top-section">
        <!-- Top border highlights -->
        <div class="row-container-top-highlights"></div>
        <!-- Bottom border highlights -->
        <div class="row-container-bottom-highlights"></div>
        <!-- Column 1: CONTACT -->
        <div class="flex-1 space-y-4 pr-0 md:pr-6 column-item">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-white/70">Contact</h3>
          <div class="space-y-3 text-sm text-white/70">
            <a href="mailto:hello@zen.ark" class="block hover:text-white transition-colors">
              hello@zen.ark
            </a>
            <a href="/contact" class="block hover:text-white transition-colors"> Get in touch </a>
            <div class="pt-2 space-y-2">
              <p class="text-white/70">.ARK Origin powers</p>
              <p class="text-white/70">.ARK Leathers</p>
              <a
                href="/about"
                class="inline-flex items-center gap-1 hover:text-white transition-colors group"
              >
                Learn more
                <svg
                  class="w-4 h-4 text-[#D9FF37] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Column 2: CONNECT -->
        <div class="flex-1 space-y-4 pl-0 md:pl-6 column-item">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-white/70">Connect</h3>
          <div class="space-y-3 text-sm text-white/70">
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              class="block hover:text-white transition-colors"
            >
              Instagram
            </a>
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="block hover:text-white transition-colors"
            >
              LinkedIn
            </a>
          </div>
        </div>
      </div>

      <!-- Flexbox 2: Middle section - full width -->
      <div class="flex w-full py-12 md:py-16 ark-section" id="ark-section">
        <h2
          class="text-7xl md:text-9xl lg:text-[12rem] font-bold uppercase tracking-[-0.02em] text-[#D9FF37] text-center leading-[0.9] w-full"
        >
          .ARK
        </h2>
      </div>

      <!-- Flexbox 3: Bottom section - full width -->
      <div
        class="flex w-full pt-6 md:pt-8 flex-col md:flex-row items-center justify-between gap-4 text-xs md:text-sm text-white/60"
      >
        <p>© {currentYear} .ARK</p>
        <a href="/datenschutz" class="hover:text-white transition-colors"> Privacy Policy </a>
      </div>
    </div>
  </div>
</footer>

<style>
  #site-footer {
    background-color: #000000;
    /* Top border for grid - visible above contact and connect */
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* Ensure the footer container shows the top border */
  #site-footer > div {
    position: relative;
  }

  /* Make sure top section aligns with footer top border */
  .row-container {
    margin-top: 0;
  }

  /* Row container: left, right, and bottom borders */
  /* Left and right borders will extend through .ARK section via ark-section borders */
  .row-container {
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    border-right: 1px solid rgba(255, 255, 255, 0.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    position: relative;
  }

  /* Center vertical divider - spans full height of top section, connects to bottom line */
  .row-container::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: -1px; /* Extend to the border line */
    width: 1px;
    background: rgba(255, 255, 255, 0.2);
    transform: translateX(-50%);
    z-index: 0;
  }

  /* Column vertical dividers */
  .column-item:not(:first-child) {
    border-left: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* Intersection highlights using ::before pseudo-elements with linear gradients */
  /* Each column's ::before creates highlights at all 4 corners - matching inversa.com approach */
  .column-item::before {
    content: "";
    display: block;
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    bottom: -1px;
    pointer-events: none;
    z-index: 1;
    /* 8 linear gradients positioned at corners to create glowing intersection dots */
    /* Each gradient creates a small dot where lines meet */
    background-image: 
      /* Top-left: horizontal line going right, vertical line going down */
      linear-gradient(90deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      linear-gradient(rgba(255, 255, 255, 0.5) 1px, transparent 0),
      /* Top-right: horizontal line going left, vertical line going down */
        linear-gradient(270deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      linear-gradient(rgba(255, 255, 255, 0.5) 1px, transparent 0),
      /* Bottom-left: horizontal line going right, vertical line going up */
        linear-gradient(90deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      linear-gradient(0deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      /* Bottom-right: horizontal line going left, vertical line going up */
        linear-gradient(270deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      linear-gradient(0deg, rgba(255, 255, 255, 0.5) 1px, transparent 0);
    background-size: 4.5px 4.5px;
    background-position:
      /* Top-left corner */
      0 0,
      0 0,
      /* Top-right corner */ 100% 0,
      100% 0,
      /* Bottom-left corner */ 0 100%,
      0 100%,
      /* Bottom-right corner */ 100% 100%,
      100% 100%;
    background-repeat: no-repeat;
  }

  /* .ARK section: left, right, and bottom borders (continuing the grid) */
  .ark-section {
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    border-right: 1px solid rgba(255, 255, 255, 0.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    position: relative;
  }

  /* Highlights at top border intersections (footer top meets row left/right/center) */
  /* Using a wrapper div for top highlights since ::before is used for vertical divider */
  .row-container-top-highlights {
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 1px;
    pointer-events: none;
    z-index: 2;
    background-image: 
      /* Top-left corner */
      linear-gradient(90deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      linear-gradient(rgba(255, 255, 255, 0.5) 1px, transparent 0),
      /* Top-center (where vertical divider meets top) */
        linear-gradient(90deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      linear-gradient(rgba(255, 255, 255, 0.5) 1px, transparent 0),
      /* Top-right corner */ linear-gradient(270deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      linear-gradient(rgba(255, 255, 255, 0.5) 1px, transparent 0);
    background-size: 4.5px 4.5px;
    background-position:
      0 0,
      0 0,
      50% 0,
      50% 0,
      100% 0,
      100% 0;
    background-repeat: no-repeat;
  }

  /* Bottom border highlights - using a div element since ::before and ::after are used */
  .row-container-bottom-highlights {
    position: absolute;
    bottom: -1px;
    left: -1px;
    right: -1px;
    height: 1px;
    pointer-events: none;
    z-index: 2;
    background-image: 
      /* Bottom-left corner */
      linear-gradient(90deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      linear-gradient(0deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      /* Bottom-center (where vertical divider meets bottom) */
        linear-gradient(90deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      linear-gradient(0deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      /* Bottom-right corner */ linear-gradient(270deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      linear-gradient(0deg, rgba(255, 255, 255, 0.5) 1px, transparent 0);
    background-size: 4.5px 4.5px;
    background-position:
      0 0,
      0 0,
      50% 0,
      50% 0,
      100% 0,
      100% 0;
    background-repeat: no-repeat;
  }

  /* Highlights at .ARK section bottom border intersections */
  #ark-section::after {
    content: "";
    display: block;
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    pointer-events: none;
    z-index: 1;
    background-image: 
      /* Bottom-left corner */
      linear-gradient(90deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      linear-gradient(0deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      /* Bottom-right corner */ linear-gradient(270deg, rgba(255, 255, 255, 0.5) 1px, transparent 0),
      linear-gradient(0deg, rgba(255, 255, 255, 0.5) 1px, transparent 0);
    background-size: 4.5px 4.5px;
    background-position:
      0 0,
      0 0,
      100% 0,
      100% 0;
    background-repeat: no-repeat;
  }

  /* Hide highlights on mobile */
  @media (max-width: 767px) {
    .column-item::before,
    .row-container-top-highlights,
    .row-container-bottom-highlights,
    #ark-section::after {
      display: none;
    }
    .row-container::before {
      display: none;
    }
  }
</style>
