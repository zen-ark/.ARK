---
const previewUrl = "https://neat-themes-627149.framer.app/";
const segmentCount = 10;
---

<div class="preview-ticker" role="region" aria-label="Portfolio preview notice">
  <div class="preview-ticker__viewport">
    <div class="preview-ticker__track">
      {
        [0, 1].map((group) => (
          <div
            class="preview-ticker__group"
            aria-hidden={group === 1 ? true : undefined}
          >
            {Array.from({ length: segmentCount }).map(() => (
              <span class="preview-ticker__item">
                <span class="preview-ticker__label">Building new portfolio</span>
                <span class="preview-ticker__dot" aria-hidden="true" />
                <a
                  class="preview-ticker__link"
                  href={previewUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex={group === 0 ? undefined : -1}
                >
                  Preview it here
                  <span class="preview-ticker__arrow" aria-hidden="true">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 12 12"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M2.5 9.5L9.5 2.5M9.5 2.5H5M9.5 2.5V7"
                        stroke="currentColor"
                        stroke-width="1.35"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </a>
                <span class="preview-ticker__sep" aria-hidden="true">
                  ||
                </span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  :global(:root) {
    --preview-ticker-height: 2rem;
  }

  .preview-ticker {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10010;
    height: var(--preview-ticker-height);
    background: #050505;
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 1px 0 rgba(0, 0, 0, 0.4);
    overflow: hidden;
    isolation: isolate;
  }

  .preview-ticker::before,
  .preview-ticker::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(2rem, 8vw, 4rem);
    z-index: 2;
    pointer-events: none;
  }

  .preview-ticker::before {
    left: 0;
    background: linear-gradient(90deg, #050505 15%, transparent);
  }

  .preview-ticker::after {
    right: 0;
    background: linear-gradient(270deg, #050505 15%, transparent);
  }

  .preview-ticker__viewport {
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .preview-ticker__track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: preview-ticker-scroll 38s linear infinite;
    will-change: transform;
  }

  .preview-ticker__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .preview-ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding-right: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }

  .preview-ticker__label {
    color: rgba(255, 255, 255, 0.72);
  }

  .preview-ticker__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    flex-shrink: 0;
  }

  .preview-ticker__link {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.4rem;
    color: #fff;
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .preview-ticker__link:hover {
    color: rgba(255, 255, 255, 0.75);
  }

  .preview-ticker__arrow {
    display: block;
    width: 1.28em;
    height: 1.28em;
    flex-shrink: 0;
    margin-bottom: 0.04em;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .preview-ticker__arrow svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .preview-ticker__link:hover .preview-ticker__arrow {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  .preview-ticker__sep {
    color: rgba(255, 255, 255, 0.22);
    letter-spacing: 0.2em;
    padding-left: 0.15rem;
  }

  @keyframes preview-ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-ticker__track {
      animation: none;
      margin-inline: auto;
    }

    .preview-ticker__group[aria-hidden="true"] {
      display: none;
    }

    .preview-ticker::before,
    .preview-ticker::after {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .preview-ticker__item {
      font-size: 0.625rem;
      letter-spacing: 0.08em;
      padding-right: 2rem;
      gap: 0.5rem;
    }
  }
</style>
