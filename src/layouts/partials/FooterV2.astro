  <!-- Third Row: Copyright, Privacy Policy, Crafted by -->
  <div class="row-last">
    <a href="/" class="copyright-link"> ©{currentYear} INVERSA </a>
    <ul class="legal">
      <li class="item">
        <a href="/privacy-policy" class="legal-link"> Privacy Policy </a>
      </li>
    </ul>
    <a href="https://www.exoape.com/" rel="noopener noreferrer" target="_blank" class="legal-link">
      Crafted by Exo Ape
      <svg viewBox="0 0 7 7" fill="none" xmlns="http://www.w3.org/2000/svg" class="link-svg">
