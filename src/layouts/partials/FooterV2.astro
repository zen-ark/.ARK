          d="M1.2 7L0.5 6.3L5.3 1.5H1V0.5H7V6.5H6V2.2L1.2 7Z"
          fill="currentcolor"></path>
      </svg>
    </a>
  </div>
</footer>

<style>
  /* Footer - style-0 */
  .footer {
    margin: 48.1px 0 0 0;
    padding: 1rem;
    border-top: 1px solid rgb(64, 64, 64);
    background-color: #000000;
    color: rgb(244, 243, 232);
    box-sizing: border-box;
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }

  /* First Row - style-1 */
  .row-first {
    display: flex;
    position: relative;
    box-sizing: border-box;
    border-left: 1px solid rgb(64, 64, 64);
    border-right: 1px solid rgb(64, 64, 64);
    border-bottom: 1px solid rgb(64, 64, 64);
  }

  /* First Column - style-2 */
  .column-first {
    flex: 1 1 0%;
    padding: 48.84px;
    position: relative;
    box-sizing: border-box;
  }

  /* Middle Columns - style-16, style-23 */
  .column-middle {
    flex: 1 1 0%;
    padding: 48.84px;
    position: relative;
    box-sizing: border-box;
    border-left: 1px solid rgb(64, 64, 64);
  }

  /* Vertical dividers - z-index: 2 (above horizontal borders) */
  .column-middle::before {
    content: "";
    position: absolute;
    top: -1px;
    bottom: -1px;
    left: -1px;
    width: 1px;
    background: rgb(64, 64, 64);
    z-index: 2;
    pointer-events: none;
  }

  /* Junction highlights - 10px vertical segments at every intersection - z-index: 3 (above all lines) */
  .junction-highlight {
    position: absolute;
    pointer-events: none;
    z-index: 3;
    width: 1px;
    height: 10px;
    background: rgb(235, 252, 114);
  }

  /* Footer top border junctions - positioned relative to footer */
  .junction-footer-top-left {
    top: 0;
    left: 0;
  }

  .junction-footer-top-divider-1 {
    top: 0;
    left: calc(33.333333% - 0.5px);
  }

  .junction-footer-top-divider-2 {
    top: 0;
    left: calc(66.666667% - 0.5px);
  }

  .junction-footer-top-right {
    top: 0;
    right: 0;
  }

  /* Top-left corner of row-first */
  .junction-top-left {
    top: -1px;
    left: -1px;
    transform: translate(-50%, -50%);
  }

  /* Top-right corner of row-first */
  .junction-top-right {
    top: -1px;
    right: -1px;
    transform: translate(50%, -50%);
  }

  /* Bottom-left corner of row-first */
  .junction-bottom-left {
    bottom: -1px;
    left: -1px;
    transform: translate(-50%, 50%);
  }

  /* Bottom-right corner of row-first */
  .junction-bottom-right {
    bottom: -1px;
    right: -1px;
    transform: translate(50%, 50%);
  }

  /* Vertical divider meets top border (row-first) */
  .junction-divider-top {
    top: -1px;
    left: -1px;
    transform: translate(-50%, -50%);
  }

  /* Vertical divider meets middle horizontal border (between row-first and row-logo) */
  .junction-divider-middle {
    bottom: -1px;
    left: -1px;
    transform: translate(-50%, 50%);
  }

  /* Vertical divider meets bottom border (row-logo) */
  .junction-divider-bottom {
    bottom: -1px;
    left: -1px;
    transform: translate(-50%, 50%);
  }

  /* Logo row top-left corner */
  .junction-logo-top-left {
    top: -1px;
    left: -1px;
    transform: translate(-50%, -50%);
  }

  /* Logo row top-right corner */
  .junction-logo-top-right {
    top: -1px;
    right: -1px;
    transform: translate(50%, -50%);
  }

  /* Logo row bottom-left corner */
  .junction-logo-bottom-left {
    bottom: -1px;
    left: -1px;
    transform: translate(-50%, 50%);
  }

  /* Logo row bottom-right corner */
  .junction-logo-bottom-right {
    bottom: -1px;
    right: -1px;
    transform: translate(50%, 50%);
  }

  /* Vertical divider junction highlights positioned relative to column-middle */
  .column-middle .junction-divider-top {
    top: -1px;
    left: -1px;
    transform: translate(-50%, -50%);
  }

  .column-middle .junction-divider-middle {
    bottom: -1px;
    left: -1px;
    transform: translate(-50%, 50%);
  }

  .column-middle .junction-divider-bottom {
    bottom: -1px;
    left: -1px;
    transform: translate(-50%, 50%);
  }

  /* Vertical dividers meet logo row top border - positioned at same x as dividers */
  .junction-logo-divider-top-1 {
    top: -1px;
    left: calc(33.333% - 0.5px);
    transform: translate(-50%, -50%);
  }

  .junction-logo-divider-top-2 {
    top: -1px;
    left: calc(66.666% - 0.5px);
    transform: translate(-50%, -50%);
  }

  /* Vertical dividers meet logo row bottom border */
  .junction-logo-divider-bottom-1 {
    bottom: -1px;
    left: calc(33.333% - 0.5px);
    transform: translate(-50%, 50%);
  }

  .junction-logo-divider-bottom-2 {
    bottom: -1px;
    left: calc(66.666% - 0.5px);
    transform: translate(-50%, 50%);
  }

  .junction-top::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    transform: translate(-50%, -50%);
    width: 1px;
    height: 10px;
    background: rgb(235, 252, 114);
  }

  .junction-top::after {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    height: 1px;
    background: rgb(235, 252, 114);
  }

  /* Title - style-3, style-17, style-24 */
  .title {
    margin-bottom: 70.3px;
    font-family: "JetBrains Mono", monospace;
    font-size: 14.8px;
    font-weight: 300;
    line-height: 18.5px;
    text-transform: uppercase;
    align-items: center;
    display: flex;
    box-sizing: border-box;
  }

  /* Links List - style-4, style-18 */
  .links {
    margin: 0px;
    list-style: outside none none;
    padding: 0px;
    box-sizing: border-box;
  }

  /* List Item - style-5, style-7, style-19, style-21 */
  .item {
    margin: 0px;
    box-sizing: border-box;
  }

  /* Regular Link - style-6, style-8, style-20, style-22 */
  .link {
    font-family: "NB International Pro", sans-serif;
    font-size: 11.84px;
    font-weight: 400;
    line-height: 19.1808px;
    position: relative;
    color: rgb(244, 243, 232);
    text-decoration: none;
    box-sizing: border-box;
  }

  /* Leathers Link - style-10 */
  .sublink {
    flex-direction: column;
    display: flex;
    font-family: "NB International Pro", sans-serif;
    font-size: 10.36px;
    font-weight: 400;
    line-height: 12.95px;
    position: relative;
    color: rgb(244, 243, 232);
    text-decoration: none;
    box-sizing: border-box;
  }

  /* Leathers Item - style-9 */
  .item.leathers {
    margin-top: 85.1px;
    display: inline-flex;
    box-sizing: border-box;
  }

  /* Learn More - style-13 */
  .more {
    display: flex;
    margin-top: 7.4px;
    box-sizing: border-box;
  }

  /* Link SVG - style-14, style-49 */
  .link-svg {
    color: rgb(235, 252, 114);
    height: 5.17188px;
    margin: 4.44px 0px 0px 4.44px;
    width: 0.7rem;
    overflow: visible;
    display: block;
    user-select: none;
    box-sizing: border-box;
  }

  /* Subscribe Container - style-25 */
  .subscribe {
    position: relative;
    box-sizing: border-box;
  }

  /* Form - style-26 */
  .form {
    box-sizing: border-box;
  }

  /* Input - style-27 */
  .input {
    border-width: 0px 0px 1px;
    border-top-style: none;
    border-right-style: none;
    border-left-style: none;
    border-color: rgb(244, 243, 232);
    border-image: none;
    border-bottom-style: solid;
    border-radius: 0px;
    font-family: "NB International Pro", sans-serif;
    font-size: 11.84px;
    font-weight: 400;
    padding: 0px 0px 3.7px;
    width: 100%;
