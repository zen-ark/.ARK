---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <!-- First Row: Contact, Connect, Subscribe -->
  <div class="row-first">
    <!-- Junction highlights for row-first -->
    <div class="junction-highlight junction-top-left"></div>
    <div class="junction-highlight junction-top-right"></div>
    <div class="junction-highlight junction-bottom-left"></div>
    <div class="junction-highlight junction-bottom-right"></div>

    <!-- Contact Column -->
    <div class="column-first">
      <h3 class="title">Contact</h3>
      <ul class="links">
        <li class="item">
          <a href="mailto:info@inversa.com" rel="noopener noreferrer" class="link">
            info@inversa.com
          </a>
        </li>
        <li class="item">
          <a href="/contact" class="link"> Get in touch </a>
        </li>
        <li class="item leathers">
          <a
            href="https://www.inversaleathers.com/"
            rel="noopener noreferrer"
            target="_blank"
            class="sublink"
          >
            INVERSA Origin powers<br />
            INVERSA Leathers<br />
            <div class="more">
              Learn more
              <svg
                viewBox="0 0 7 7"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="link-svg"
              >
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M1.2 7L0.5 6.3L5.3 1.5H1V0.5H7V6.5H6V2.2L1.2 7Z"
                  fill="currentcolor"></path>
              </svg>
            </div>
          </a>
        </li>
      </ul>
    </div>

    <!-- Connect Column -->
    <div class="column-middle">
      <!-- Junction highlights for vertical divider -->
      <div class="junction-highlight junction-divider-top"></div>
      <div class="junction-highlight junction-divider-middle"></div>
      <div class="junction-highlight junction-divider-bottom"></div>
      <h3 class="title">Connect</h3>
      <ul class="links">
        <li class="item">
          <a
            href="https://www.instagram.com/inversa.leathers/"
            rel="noopener noreferrer"
            target="_blank"
            class="link"
          >
            Instagram
          </a>
        </li>
        <li class="item">
          <a
            href="https://www.linkedin.com/company/inversa-leathers/"
            rel="noopener noreferrer"
            target="_blank"
            class="link"
          >
            LinkedIn
          </a>
        </li>
      </ul>
    </div>

    <!-- Subscribe Column -->
    <div class="column-middle">
      <!-- Junction highlights for vertical divider -->
      <div class="junction-highlight junction-divider-top"></div>
      <div class="junction-highlight junction-divider-middle"></div>
      <div class="junction-highlight junction-divider-bottom"></div>
      <h3 class="title">Subscribe</h3>
      <div class="subscribe">
        <form action="https://formspree.io/f/mldpdyga" method="POST" class="form">
          <input type="email" name="email" placeholder="Email" required="" class="input" />
          <input class="hidden" type="text" name="_gotcha" />
          <button type="submit" aria-label="Subscribe" class="submit">
            <svg
              viewBox="0 0 12 10"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="arrow-svg"
            >
              <path
                d="M10.7919 5.86117L12 7.10371L9.18114 10.003L7.97304 8.76043L10.7919 5.86117Z"
                fill="currentcolor"></path>
              <path
                d="M12 2.90023L10.7918 4.14277L7.97294 1.24351L9.18104 0.000976562L12 2.90023Z"
                fill="currentcolor"></path>
              <path
                d="M9.68159 4.10336V5.86057L0 5.86057L7.46822e-08 4.10336L9.68159 4.10336Z"
                fill="currentcolor"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Second Row: INVERSA Logo SVG -->
  <div class="row-logo">
    <!-- Junction highlights for row-logo corners -->
    <div class="junction-highlight junction-logo-top-left"></div>
    <div class="junction-highlight junction-logo-top-right"></div>
    <div class="junction-highlight junction-logo-bottom-left"></div>
    <div class="junction-highlight junction-logo-bottom-right"></div>
    <!-- Junction highlights where vertical dividers (from top row) meet logo row borders -->
    <div class="junction-highlight junction-logo-divider-top-1"></div>
    <div class="junction-highlight junction-logo-divider-top-2"></div>
    <div class="junction-highlight junction-logo-divider-bottom-1"></div>
    <div class="junction-highlight junction-logo-divider-bottom-2"></div>
