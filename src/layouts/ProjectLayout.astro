---
import Base from "./Base.astro";
import { buildArticleSchema, formatJsonLd } from "@/lib/seo";

interface Props {
  title: string;
  description: string;
  date: string;
  author?: string;
  ogImage?: string;
  slug: string;
  prevProject?: { slug: string; title: string; cover?: string };
  nextProject?: { slug: string; title: string; cover?: string };
  isCaseStudy?: boolean;
  basePath?: string;
}

const {
  title,
  description,
  date,
  author = ".ARK",
  ogImage,
  slug,
  prevProject,
  nextProject,
  isCaseStudy = false,
  basePath = "/projects",
} = Astro.props;

const siteUrl = import.meta.env.SITE || "https://ark.studio.ch";
const projectUrl = new URL(`${basePath}/${slug}`, siteUrl).toString();

const articleSchema = buildArticleSchema({
  headline: title,
  description,
  author,
  datePublished: date,
  image: ogImage ? new URL(ogImage, siteUrl).toString() : undefined,
  url: projectUrl,
});
---

<Base
  title={`${title} — .ARK`}
  description={description}
  ogImage={ogImage}
  canonical={projectUrl}
  ogType="article"
  footerMode={basePath.includes("portfolio") ? "reveal" : "default"}
  wrapperClass={basePath.includes("portfolio") ? "bg-[#111]" : ""}
>
  <!-- Hero Image Section - Full Width with Border -->
  {
    !isCaseStudy && ogImage && (
      <div class="w-full px-4 pt-4">
        <div
          class="w-full h-[40vh] md:h-[60vh] relative overflow-hidden bg-transparent"
          style={{
            borderRadius: "var(--space-8)",
            backgroundColor: "transparent",
          }}
        >
          <img
            src={ogImage}
            alt={title}
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    )
  }

  <!-- Content Section -->
  {
    isCaseStudy ? (
      <div class="w-full bg-[#111] text-white min-h-screen">
        <slot />
      </div>
    ) : (
      <article class="max-w-6xl mx-auto px-4 md:px-6 py-8 md:py-12">
        <slot />
      </article>
    )
  }

  <!-- Article Schema -->
  <script type="application/ld+json" set:html={formatJsonLd(articleSchema)} slot="head" />
</Base>
