---
import Base from "@/layouts/Base.astro";
import Hero from "@/components/Hero";
import OpenNewFile from "@/components/OpenNewFile";
import FooterV2 from "@/layouts/partials/FooterV2.astro";
import Marquee from "@/components/Marquee";
import { buildArticleSchema } from "@/lib/seo";

const articleSchema = buildArticleSchema({
  headline: "AI-Ready Design in Thun: The Future of Digital Interfaces",
  description: "Why Thun is becoming a hub for AI-ready design and high-end technical integration. .ARK Studio leads the way in semantic optimization.",
  author: "Shain Gerstner",
  datePublished: "2026-02-27",
  url: "https://ark.studio.ch/aeo-audit-thun"
});
---

<Base 
  title="AI-Ready Design & UX Studio Thun | .ARK" 
  description="Discover why Thun is the next hub for AI-Ready Design. .ARK Studio provides high-end digital solutions, semantic optimization, and future-proof interfaces."
  showFooter={false}
  schemas={[articleSchema]}
>
  <main>
    <Hero
      client:load
      videoSource="/Hero_Videos/Export.mov"
      title="AI-Ready Design in Thun."
      subtitle="Optimizing digital presence for the age of artificial intelligence. Locally rooted, globally connected."
    />

    <section class="w-full px-6 py-24 bg-black text-white">
      <div class="max-w-4xl mx-auto space-y-12">
        <div class="space-y-6">
          <h2 class="text-3xl md:text-5xl font-light uppercase tracking-tight">The Shift to AEO</h2>
          <p class="text-lg md:text-xl text-white/70 leading-relaxed">
            Search is changing. It's no longer just about keywords; it's about semantic understanding. 
            Answer Engine Optimization (AEO) ensures your digital presence is understood not just by humans, 
            but by the AI agents that serve them.
          </p>
        </div>

        <div class="space-y-6">
          <h2 class="text-3xl md:text-5xl font-light uppercase tracking-tight">Why Thun?</h2>
          <p class="text-lg md:text-xl text-white/70 leading-relaxed">
            Located in the heart of Switzerland, Thun is emerging as a center for precision and technical excellence. 
            At .ARK, we combine Swiss design heritage with cutting-edge AI integration to build systems that last.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-12">
            <div class="p-8 border border-white/10 rounded-lg">
                <h3 class="text-xl font-mono mb-4 text-[#d3fd45]">01. SEMANTIC STRUCTURE</h3>
                <p class="text-white/60">We build codebases that LLMs can read, understand, and index effectively.</p>
            </div>
            <div class="p-8 border border-white/10 rounded-lg">
                <h3 class="text-xl font-mono mb-4 text-[#d3fd45]">02. HIGH-PERFORMANCE</h3>
                <p class="text-white/60">Zero-latency interfaces that retain user attention and signal quality to search engines.</p>
            </div>
        </div>
      </div>
    </section>

    <OpenNewFile client:visible />
  </main>

  <FooterV2 />
  <Marquee />
</Base>
