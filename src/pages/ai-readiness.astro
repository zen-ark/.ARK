---
import Base from "@/layouts/Base.astro";
import AEORadar from "@/components/AEORadar";
import EfficiencyCalculator from "@/components/EfficiencyCalculator";
import AutomationContactForm from "@/components/AutomationContactForm";
import FAQ, { faqData } from "@/components/FAQ";
import DirectAnswer from "@/components/DirectAnswer.astro";
import FooterV2 from "@/layouts/partials/FooterV2.astro";
import { buildServiceSchema, buildFAQPageSchema } from "@/lib/seo";

const serviceSchema = buildServiceSchema({
  name: "AI Readiness Audit",
  description: "Comprehensive audit and strategy to prepare your digital presence for AI search engines and autonomous agents.",
  provider: { name: ".ARK", url: "https://ark.studio.ch" },
  serviceType: "Consulting",
  areaServed: "Switzerland, Thun, Bern"
});

const faqSchema = buildFAQPageSchema(faqData);

const schemas = [serviceSchema, faqSchema];
---

<Base 
  title="AI Readiness Audit | .ARK Studio Thun" 
  description="Prepare your business for the AI era. We optimize your digital presence for AI search engines (AEO) and integrate intelligent workflows."
  showFooter={false}
  theme="dark"
  schemas={schemas}
>
  <main class="min-h-screen bg-bg-canvas text-text-primary selection:bg-brand/30">
    {/* Section 1: The Hook (AEO Radar) */}
    <section class="relative min-h-screen flex flex-col justify-center items-center py-20 overflow-hidden">
      {/* Background Elements */}
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand/20 via-bg-canvas to-bg-canvas pointer-events-none"></div>
      
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto text-center mb-12">
          <h1 class="text-5xl md:text-6xl font-bold mb-6 tracking-tight">
            Is your business <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand to-brand-accent">invisible</span> to the AI your customers use?
          </h1>
          <p class="text-xl text-text-subtle mb-8 max-w-2xl mx-auto">
            The AI-Visibility Scan reveals if ChatGPT, Perplexity, and Google's SGE can actually "read" your business.
          </p>
        </div>

        <div class="flex justify-center transform scale-90 md:scale-100">
          <AEORadar client:load />
        </div>
      </div>
    </section>

    {/* Section 2: The Pain (Efficiency Calculator) */}
    <section class="py-24 bg-bg-muted border-y border-border-default">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-6">
            Stop paying your experts to <span class="text-error">copy-paste</span>.
          </h2>
          <p class="text-xl text-text-subtle">
            Calculate how much manual friction is costing your business every year.
          </p>
        </div>

        <div class="flex justify-center mb-12">
          <EfficiencyCalculator client:visible />
        </div>
      </div>
    </section>

    {/* Section 3: The Trust (The Sovereign Vault) */}
    <section class="py-24 bg-bg-canvas relative overflow-hidden">
      <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-10"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-5xl mx-auto bg-bg-surface border border-border-default rounded-12 p-8 md:p-16 backdrop-blur-xl">
          <div class="flex flex-col md:flex-row items-center gap-12">
            <div class="flex-1">
              <div class="inline-flex items-center px-3 py-1 rounded-full bg-success/10 text-success border border-success/20 text-xs font-mono mb-6">
                <span class="w-2 h-2 rounded-full bg-success mr-2 animate-pulse"></span>
                nDSG COMPLIANT
              </div>
              <h2 class="text-3xl md:text-5xl font-bold mb-6">
                Intelligence that never leaves <span class="text-error">Switzerland</span>.
              </h2>
              <p class="text-text-subtle text-lg mb-8 leading-relaxed">
                We partner with Swiss infrastructure providers like AlpineAI and Infomaniak to ensure your data remains sovereign. 
                Local LLMs (Llama/Mistral) running on secure, private hardware.
              </p>
              <ul class="space-y-4">
                <li class="flex items-center text-text-subtle">
                  <svg class="w-5 h-5 text-brand mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                  Full Data Sovereignty
                </li>
                <li class="flex items-center text-text-subtle">
                  <svg class="w-5 h-5 text-brand mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                  On-Premise or Private Cloud
                </li>
                <li class="flex items-center text-text-subtle">
                  <svg class="w-5 h-5 text-brand mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                  Zero US-Cloud Exposure
                </li>
              </ul>
            </div>
            <div class="flex-1 w-full flex justify-center">
              <div class="w-64 h-64 relative">
                <div class="absolute inset-0 bg-error/20 blur-3xl rounded-full animate-pulse"></div>
                <div class="relative z-10 w-full h-full border border-error/30 bg-bg-surface/50 backdrop-blur-md rounded-12 flex items-center justify-center">
                  <svg class="w-24 h-24 text-error" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Section 4: The Scope (The "Dual-Interface" Offer) */}
    <section class="py-24 bg-bg-muted">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
          {/* Card 1 */}
          <div class="p-8 rounded-12 bg-bg-surface border border-border-default hover:border-brand/50 transition-colors group">
            <div class="w-12 h-12 bg-brand/20 rounded-6 flex items-center justify-center mb-6 group-hover:bg-brand/40 transition-colors">
              <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <h3 class="text-2xl font-bold mb-4">AEO Audit</h3>
            <p class="text-text-subtle">Get found by ChatGPT & Perplexity. Optimize your digital footprint for the new search engines.</p>
          </div>

          {/* Card 2 */}
          <div class="p-8 rounded-12 bg-bg-surface border border-border-default hover:border-brand-accent/50 transition-colors group">
            <div class="w-12 h-12 bg-brand-accent/20 rounded-6 flex items-center justify-center mb-6 group-hover:bg-brand-accent/40 transition-colors">
              <svg class="w-6 h-6 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
            </div>
            <h3 class="text-2xl font-bold mb-4">Process Discovery</h3>
            <p class="text-text-subtle">Find the high-friction "Shadow Processes" in your KMU. We identify where automation yields the highest ROI.</p>
          </div>

          {/* Card 3 */}
          <div class="p-8 rounded-12 bg-bg-surface border border-border-default hover:border-success/50 transition-colors group">
            <div class="w-12 h-12 bg-success/20 rounded-6 flex items-center justify-center mb-6 group-hover:bg-success/40 transition-colors">
              <svg class="w-6 h-6 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path></svg>
            </div>
            <h3 class="text-2xl font-bold mb-4">Custom Frontends</h3>
            <p class="text-text-subtle">High-end UI for your proprietary AI tools. Don't settle for standard chat interfaces.</p>
          </div>

          {/* Card 4 */}
          <div class="p-8 rounded-12 bg-bg-surface border border-border-default hover:border-warning/50 transition-colors group">
            <div class="w-12 h-12 bg-warning/20 rounded-6 flex items-center justify-center mb-6 group-hover:bg-warning/40 transition-colors">
              <svg class="w-6 h-6 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 0 1 8 0z"></path></svg>
            </div>
            <h3 class="text-2xl font-bold mb-4">Managed Training</h3>
            <p class="text-text-subtle">Onboarding your team for the AI era. We ensure your employees know how to use the new tools effectively.</p>
          </div>
        </div>
      </div>
    </section>

    {/* Section 5: The Proof (The "Hausarzt" Example) */}
    <section class="py-24 bg-bg-surface border-y border-border-default">
      <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row items-center gap-16 max-w-6xl mx-auto">
          <div class="flex-1 order-2 lg:order-1">
            <div class="relative rounded-12 overflow-hidden shadow-elevation-3 border border-border-default group">
              <div class="absolute inset-0 bg-gradient-to-t from-bg-canvas/80 to-transparent z-10"></div>
              {/* Placeholder for Mockup */}
              <div class="aspect-video bg-bg-muted flex items-center justify-center relative">
                <div class="text-center p-8">
                  <div class="w-16 h-16 bg-brand/20 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                  </div>
                  <p class="text-text-tertiary font-mono text-sm">SECURE MEDICAL RAG INTERFACE</p>
                </div>
                {/* Simulated UI Elements */}
                <div class="absolute top-4 left-4 right-4 h-2 bg-bg-elevated rounded-full w-1/3"></div>
                <div class="absolute top-8 left-4 right-4 h-2 bg-bg-elevated rounded-full w-1/4"></div>
                <div class="absolute bottom-0 left-0 right-0 h-1/2 bg-bg-surface/50 backdrop-blur-sm border-t border-border-default p-4">
                  <div class="flex gap-2">
                    <div class="w-8 h-8 rounded-full bg-bg-elevated"></div>
                    <div class="flex-1 h-8 bg-bg-elevated rounded-6"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="flex-1 order-1 lg:order-2">
            <h2 class="text-3xl md:text-5xl font-bold mb-6">
              From patient data to secure internal knowledge base.
            </h2>
            <p class="text-xl text-text-subtle mb-6">
              Case Study: Medical Practice Automation
            </p>
            <p class="text-text-subtle leading-relaxed">
              We built a secure RAG (Retrieval-Augmented Generation) system that allows doctors to query their internal documentation without a single byte of patient data ever touching a US server. Fully compliant, extremely fast, and completely private.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="w-full py-24 px-6 bg-black text-[#f4f3e8]">
      <div class="max-w-4xl mx-auto space-y-12">
        <div class="space-y-6">
          <h2 class="text-3xl md:text-5xl font-light uppercase tracking-tight font-['NB_International_Pro']">
            Why AI Readiness Matters
          </h2>
          <p class="text-xl text-gray-400 leading-relaxed font-['NB_International_Pro']">
            Search is changing. Users are moving from "Googling" keywords to asking complex questions to AI agents like ChatGPT, Perplexity, and Gemini. If your digital presence isn't optimized for machine readability (AEO), you are invisible to these new gatekeepers.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-12 pt-12 border-t border-[#404040]">
          <div>
            <h3 class="text-xl font-mono mb-4 text-[#d3fd45]">01. STRUCTURED DATA</h3>
            <p class="text-gray-400">
              We implement advanced Schema.org markup (JSON-LD) to ensure AI models clearly understand who you are, what you offer, and where you operate.
            </p>
          </div>
          <div>
            <h3 class="text-xl font-mono mb-4 text-[#d3fd45]">02. ENTITY AUTHORITY</h3>
            <p class="text-gray-400">
              We connect your brand to authoritative knowledge graphs, establishing trust and relevance in your specific domain and location (Thun, Bern, Switzerland).
            </p>
          </div>
          <div>
            <h3 class="text-xl font-mono mb-4 text-[#d3fd45]">03. CONTENT SEMANTICS</h3>
            <p class="text-gray-400">
              We restructure your content to provide "Direct Answers" that LLMs can easily extract and cite, increasing your chances of being the top recommendation.
            </p>
          </div>
          <div>
            <h3 class="text-xl font-mono mb-4 text-[#d3fd45]">04. TECHNICAL HEALTH</h3>
            <p class="text-gray-400">
              We optimize site performance and accessibility, as AI agents prioritize fast, clean, and error-free digital environments.
            </p>
          </div>
        </div>
      </div>
    </section>

    <DirectAnswer />
    
    <FAQ client:visible />

    {/* Section 6: Final CTA (The Entry Point) */}
    <section id="contact" class="py-24 bg-bg-canvas relative">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-brand/10 via-bg-canvas to-bg-canvas pointer-events-none"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-3xl mx-auto text-center mb-12">
          <h2 class="text-4xl md:text-6xl font-bold mb-6">
            Ready to build your <span class="text-brand">digital brain</span>?
          </h2>
          <p class="text-xl text-text-subtle">
            Select your starting point below.
          </p>
        </div>

        <AutomationContactForm client:visible />
      </div>
    </section>
  </main>

  <FooterV2 />
</Base>
