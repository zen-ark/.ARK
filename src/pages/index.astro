---
import Base from "@/layouts/Base.astro";
import Hero from "@/components/Hero";
import WhatArkDoes from "@/components/WhatArkDoes";
import ProjectsV6 from "@/components/ProjectsV6";
import OpenNewFile from "@/components/OpenNewFile";
import SystemStateController from "@/components/SystemStateController";
import Marquee from "@/components/Marquee";
import FooterV2 from "@/layouts/partials/FooterV2.astro";
import FAQ, { faqData } from "@/components/FAQ";
import DirectAnswer from "@/components/DirectAnswer.astro";
import { buildPersonSchema, buildServiceSchema, buildFAQPageSchema } from "@/lib/seo";

const personSchema = buildPersonSchema({
  name: "Shain Gerstner",
  jobTitle: "Founder & Operator",
  url: "https://ark.studio.ch",
  sameAs: ["https://www.linkedin.com/in/shain-gerstner/", "https://www.instagram.com/mondzhain/"],
  worksFor: {
    name: ".ARK",
    url: "https://ark.studio.ch"
  }
});

const serviceSchema1 = buildServiceSchema({
  name: "Interface Design",
  description: "Crafting clear, usable, and aesthetic user interfaces for web and mobile applications.",
  provider: { name: ".ARK", url: "https://ark.studio.ch" },
  serviceType: "Design",
  areaServed: "Global"
});

const serviceSchema2 = buildServiceSchema({
  name: "Design Systems",
  description: "Building scalable and consistent design systems to streamline development and ensure brand coherence.",
  provider: { name: ".ARK", url: "https://ark.studio.ch" },
  serviceType: "Design",
  areaServed: "Global"
});

const serviceSchema3 = buildServiceSchema({
  name: "AI Readiness Audit",
  description: "Optimizing digital presence for AI search engines and integrating AI workflows for Swiss KMUs.",
  provider: { name: ".ARK", url: "https://ark.studio.ch" },
  serviceType: "Consulting",
  areaServed: "Switzerland, Thun, Bern"
});

const faqSchema = buildFAQPageSchema(faqData);

const schemas = [personSchema, serviceSchema1, serviceSchema2, serviceSchema3, faqSchema];
---

<Base 
  title=".ARK | AI-Ready Design & UX Studio Thun, Switzerland" 
  description="Boutique digital studio in Thun, Switzerland. We specialize in AI-readiness, UX/UI design, and high-end technical integration for Swiss KMUs."
  showFooter={false}
  schemas={schemas}
>
  <main>
    <!-- Hero Section -->
    <Hero
      client:load
      videoSource="/Hero_Videos/Export.mov"
      secondaryVideoSource="/Hero_Videos/2_Loops.webm"
      title="Where digital work becomes tangible."
      subtitle="Shaping interfaces with clarity, usability, and a subtle experimental edge."
    />

    <!-- WHAT .ARK DOES Section -->
    <WhatArkDoes client:visible />

    <!-- Network Registry / Validation Log (hidden for now) -->

    <!-- Projects V6 Liquid Folder -->
    <ProjectsV6 client:visible />

    <!-- SYSTEM STATE CONTROLLER (The .ARK Model) -->
    <SystemStateController client:visible />

    <!-- FAQ Section -->
    <FAQ client:visible />

    <!-- Direct Answer Section -->
    <DirectAnswer />

    <!-- OPEN A NEW FILE Section -->
    <OpenNewFile client:visible />
  </main>

  <!-- FooterV2 - Preview of inversa.com footer style -->
  <FooterV2 />
  <Marquee />

  <script>
    // Handle hash-based scrolling to projects section
    if (window.location.hash === "#projects") {
      // Wait for page to fully load, then scroll
      window.addEventListener("load", () => {
        setTimeout(() => {
          const projectsSection = document.getElementById("projects");
          if (projectsSection) {
            // Calculate scroll position accounting for sticky elements
            // Get the sticky wrapper (the parent of the sticky element)
            const stickyWrapper = document
              .querySelector('[id="what-the-ark"]')
              ?.closest(".sticky")?.parentElement;
            const stickyWrapperBottom = stickyWrapper
              ? stickyWrapper.getBoundingClientRect().bottom + window.pageYOffset
              : 0;
            const header = document.querySelector("header");
            const headerHeight = header ? header.getBoundingClientRect().height : 0;

            // Scroll to just past the sticky section, accounting for header
            const targetScroll = Math.max(
              stickyWrapperBottom - headerHeight + 20, // 20px padding
              projectsSection.getBoundingClientRect().top + window.pageYOffset - headerHeight - 20
            );

            window.scrollTo({
              top: targetScroll,
              behavior: "smooth",
            });
          }
        }, 100);
      });
    }
  </script>
</Base>
