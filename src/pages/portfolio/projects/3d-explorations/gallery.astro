---
import Base from "@/layouts/Base.astro";
import { InfiniteGallery } from "@/components/case-study/InfiniteGallery";
import GalleryButton from "@/components/case-study/GalleryButton.astro";

// Metadata
const title = "3D Explorations Gallery — .ARK";
const description = "Interactive archive of 3D motion studies and experiments.";
---

<Base
  title={title}
  description={description}
  showFooter={false}
  theme="dark"
  headerMode="hiring"
  wrapperClass="bg-black"
>
  <main class="relative w-full h-screen overflow-hidden bg-black">
    <!-- Interactive Gallery -->
    <InfiniteGallery client:load />

    <!-- Back Button -->
    <GalleryButton href="/portfolio/projects/3d-explorations" text="Close Gallery" />
  </main>
</Base>
