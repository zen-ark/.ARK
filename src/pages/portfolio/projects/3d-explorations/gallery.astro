---
import Base from "@/layouts/Base.astro";
import { InfiniteGallery } from "@/components/case-study/InfiniteGallery";

// Metadata
const title = "3D Explorations Gallery — .ARK";
const description = "Interactive archive of 3D motion studies and experiments.";
---

<Base
  title={title}
  description={description}
  showFooter={false}
  theme="dark"
  wrapperClass="bg-black"
>
  <main class="relative w-full h-screen overflow-hidden bg-black">
    <!-- Interactive Gallery -->
    <InfiniteGallery client:load />

    <!-- Back Button -->
    <a
      href="/portfolio/projects/3d-explorations"
      class="fixed bottom-[40px] left-1/2 -translate-x-1/2 z-[60] px-8 py-4 bg-white/10 hover:bg-white/20 backdrop-blur-md rounded-full text-white text-sm font-bold transition-all duration-300 border border-white/10 hover:scale-105 shadow-lg"
    >
      Exit Gallery
    </a>
  </main>
</Base>
