---
import Base from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import PortfolioAnimation from "@/components/PortfolioAnimation";
import ShainLogo from "@/components/ShainLogo";
import SmoothScroll from "@/components/SmoothScroll";
import LottiePlayer from "@/components/LottiePlayer";
import RevealOnScroll from "@/components/RevealOnScroll";

const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((p) => p.data.showInPortfolio === true)
  .map((p) => ({
    slug: p.slug,
    url: `/de/projects/${p.slug}`,
    title: p.data.title,
    cover: p.data.cover,
    coverAlt: p.data.coverAlt ?? p.data.title,
    year: p.data.year,
    featured: p.data.featured,
    orderHiring: p.data.orderHiring,
    workInProgress: p.data.workInProgress,
  }))
  .sort((a, b) => {
    // Sort by orderHiring if available (ascending: 1, 2, 3...)
    if (a.orderHiring !== undefined && b.orderHiring !== undefined) {
      return a.orderHiring - b.orderHiring;
    }
    // If one has order and other doesn't, put the one with order first
    if (a.orderHiring !== undefined) return -1;
    if (b.orderHiring !== undefined) return 1;

    // Fallback to default sort
    const yearA = a.year ?? 0;
    const yearB = b.year ?? 0;
    if (yearA !== yearB) return yearB - yearA;
    const featuredA = a.featured ? 1 : 0;
    const featuredB = b.featured ? 1 : 0;
    if (featuredA !== featuredB) return featuredB - featuredA;
    return 0;
  });
---

<Base
  title="Shain — Portfolio"
  lang="de"
  showFooter={true}
  footerMode="reveal"
  wrapperClass="bg-[#111]"
>
  <SmoothScroll client:load />
  <main class="portfolio-container">
    <PortfolioAnimation client:load>
      <header class="portfolio-header">
        <div class="logo-container shain-logo-wrapper">
          <ShainLogo />
        </div>

        <div class="portfolio-content-wrapper">
          <div class="portfolio-intro portfolio-intro-content">
            <div class="intro-link">
              <a href="/de" class="studio-link">Das Studio <span class="arrow">→</span></a>
            </div>
            <div class="intro-text">
              <h1>
                <span class="block w-full text-right"
                  >UI/UX-Designer, der Komplexität in klare Bildschirme verwandelt —</span
                >
                <span class="block w-full text-left"
                  >von der Konzeption bis zur entwicklungsfertigen Übergabe, mit hochwertigem 3D &
                  Motion, um Schlüsselmomente zu steigern, ohne die Usability zu opfern.</span
                >
              </h1>
            </div>
          </div>

          <div id="work" class="projects-grid projects-grid-content">
            {
              projects.map((project, index) => {
                // Uniform 50/50 Layout
                // All items take up half the grid (6/12 columns)
                let gridClass = "span-6";

                const isPriority = index < 3;
                const isLottie = project.cover.endsWith(".json");
                const isVideo = project.cover.match(/\.(mp4|webm|mov)$/i);
                // Identifying projects that need background color patching
                const needsDarkBg =
                  project.slug === "trauffer" || project.slug === "movieworld-spiez";
                const isWIP = project.workInProgress;

                const content = (
                  <>
                    <div class="project-image-container relative">
                      {isWIP && <div class="wip-banner">Work in Progress</div>}
                      {isLottie ? (
                        <LottiePlayer
                          src={project.cover.replace(/ /g, "%20")}
                          className="project-image"
                          loop={true}
                          client:visible
                          backgroundColor={needsDarkBg ? "#111111" : undefined}
                          isFirst={index === 0}
                        />
                      ) : isVideo ? (
                        <video
                          src={project.cover.replace(/ /g, "%20")}
                          class={`project-image ${isWIP ? "opacity-50" : ""}`}
                          muted
                          loop
                          playsinline
                          preload={isPriority ? "auto" : "metadata"}
                        />
                      ) : (
                        <img
                          src={project.cover.replace(/ /g, "%20")}
                          alt={project.coverAlt}
                          class={`project-image ${isWIP ? "opacity-50" : ""}`}
                          loading={isPriority ? "eager" : "lazy"}
                          fetchpriority={isPriority ? "high" : "auto"}
                        />
                      )}
                      {!isWIP && <div class="image-overlay" />}
                    </div>
                    <div class="project-info">
                      <span class="project-title">{project.title}</span>
                      <span class="project-date">{project.year}</span>
                    </div>
                  </>
                );

                return (
                  <div class={`project-item ${gridClass}`}>
                    <div class="project-item-content">
                      {isWIP ? (
                        <div class="project-card-link cursor-default">{content}</div>
                      ) : (
                        <a href={project.url} class="project-card-link">
                          {content}
                        </a>
                      )}
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </header>
    </PortfolioAnimation>
  </main>

  <style>
    :global(body) {
      --nav-text: #fff;
    }

    :global(#glass-overlay) {
      --nav-text: #000;
    }

    .portfolio-container {
      padding: 0;
      background-color: #111; /* Dark background as per reference image */
      color: #fff;
      min-height: 100vh;
    }

    .portfolio-header {
      padding: var(--space-4);
      margin-bottom: var(--space-16);
      position: relative;
      /* Ensure header takes up space but allows things to be sticky if we wanted pure CSS sticky, 
       but we are using GSAP for parallax so relative is fine */
    }

    /* We need a wrapper to act as the scroll container if we were doing custom scrolling, 
     but standard body scroll works with GSAP ScrollTrigger */

    .logo-container {
      width: 100%;
      margin-top: 16px;
      margin-bottom: var(--space-8);
      /* padding: 0 16px; Removed to align with projects */
      color: #fff;
      box-sizing: border-box;
      /* Will be animated by GSAP */
      position: relative;
      z-index: 1;
    }

    .portfolio-content-wrapper {
      position: relative;
      z-index: 10;
      background-color: #111;
      margin-top: 4rem;
    }

    /*
     * Pre-hide animated targets at first paint (no React wrapper dependency).
     * Uses visibility + opacity so GSAP autoAlpha reveals them atomically.
     */
    .portfolio-intro-content,
    .projects-grid-content .project-item {
      visibility: hidden;
      opacity: 0;
      transform: translateY(30px);
    }

    .shain-logo-wrapper :global(.shain-logo .letter) {
      visibility: hidden;
      opacity: 0;
    }

    .portfolio-intro {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-4);
      /* Padding 32px top, 48px bottom (increased from 16px), 16px sides */
      padding: 32px 16px 48px 16px;
      position: relative;
      background-color: #111; /* Ensure background color is set */
      z-index: 10;
      margin-bottom: -1px; /* Ensure overlap */
    }

    /* 
     For the specific effect requested: "scrolls over the title SHAIN".
     We can make the logo container sticky or fixed, and let the rest scroll over it.
     But since we are using GSAP in the wrapper component, let's let GSAP handle the movement.
     We just need to ensure z-indices are correct:
     Logo: lower z-index
     Intro & Grid: higher z-index and have background color.
  */

    @media (min-width: 768px) {
      .portfolio-intro {
        display: block;
        position: relative;
      }

      .intro-link {
        position: absolute;
        top: 32px; /* Align with container top padding */
        left: 0;
        width: 25%;
        /* Ensure it aligns with the padding of the container */
        padding-left: 16px; /* Align with container side padding */
      }

      .intro-text {
        width: 100%;
      }
    }

    /* Mobile styles for intro layout */
    @media (max-width: 767px) {
      .portfolio-intro {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding: 24px 16px 32px 16px;
        padding-top: max(24px, env(safe-area-inset-top));
      }

      .intro-link {
        position: relative;
        width: 100%;
        margin-bottom: var(--space-2);
      }

      .intro-text {
        width: 100%;
      }

      /* On mobile, align text left normally, no forced right/left split if it looks weird */
      .intro-text h1 span.text-right {
        text-align: left;
      }
    }

    .studio-link {
      color: #fff;
      text-decoration: underline;
      font-size: 1.25rem;
      text-underline-offset: 4px;
    }

    .studio-link:hover {
      opacity: 0.8;
    }

    .intro-text h1 {
      /* Fluid typography: 
         Min font: 1.5rem (24px) at 320px viewport
         Max font: 3rem (48px) at 1920px viewport
         Slope: (48 - 24) / (1920 - 320) = 24 / 1600 = 0.015
         y-intercept: 24 - (0.015 * 320) = 19.2
         Equation: 19.2px + 1.5vw
      */
      font-size: clamp(1.5rem, 1.2rem + 1.5vw, 3rem);
      line-height: 1.1;
      font-weight: 500;
      max-width: 100%;
      margin: 0;
    }

    @media (min-width: 768px) {
      .intro-text h1 {
        /* text-indent: 25vw; Removed as we are using block spans now */
      }
    }

    .projects-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding: 0 16px 2rem 16px; /* Reduced bottom padding */
      position: relative;
      z-index: 10;
      background-color: #111; /* Cover the parallax logo */
      min-height: 100vh; /* Ensure it covers even if few projects */
      margin-top: -1px; /* Ensure overlap */
    }

    @media (min-width: 768px) {
      .projects-grid {
        grid-template-columns: repeat(12, 1fr);
        column-gap: 2rem;
        row-gap: 4rem;
        padding: 0 16px 2rem 16px;
      }

      .span-6 {
        grid-column: span 6;
      }

      .span-7 {
        grid-column: span 7;
      }

      .span-5 {
        grid-column: span 5;
      }

      .span-7 .project-image-container,
      .span-5 .project-image-container {
        aspect-ratio: 16/9;
      }

      /* Vertical Offset for every second item (Right Column) - APPLIED TO INNER CONTENT */
      /* Note: We target the inner content div because the outer div is now a React component wrapper */
      /* But wait, in Astro, the React component renders a div with the class we passed. */
      /* So .project-item:nth-child(even) should still work if RevealOnScroll renders a div with that class. */
      /* However, RevealOnScroll is a sibling in the grid now. */

      /* Let's double check the CSS selector. */
      /* The projects-grid contains RevealOnScroll elements. */
      /* RevealOnScroll renders a motion.div with className="project-item span-6" */
      /* So :nth-child(even) on .project-item should work if we target .project-item directly or use child selector on grid */

      /* The CSS below targets .project-item:nth-child(even) .project-item-content */
      /* This assumes .project-item is the direct child of the grid. */
      /* Since RevealOnScroll renders the div with .project-item class, this is correct. */

      .project-item:nth-child(even) .project-item-content {
        margin-top: 10vh;
      }
    }

    @media (max-width: 767px) {
      .intro-text h1 span {
        text-align: left !important;
      }

      .span-6,
      .span-4,
      .span-3,
      .span-2 {
        grid-column: span 1;
      }
    }

    /* .project-item is now applied to the RevealOnScroll wrapper */
    .project-item {
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .project-card-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .project-image-container {
      width: 100%;
      background-color: #111; /* Match page background to prevent flickering */
      border-radius: 0px;
      overflow: hidden;
      margin-bottom: 0.5rem;
      aspect-ratio: 16/9;
      transform: translateZ(0); /* Fix for Safari flickering */
    }

    .span-6 .project-image-container {
      aspect-ratio: 16/9;
    }

    .project-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      opacity: 1; /* Fully visible by default */
    }

    .wip-banner {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      padding: 0.5rem 1rem;
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #fff;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      z-index: 20;
      border-radius: 9999px;
      pointer-events: none;
    }

    .image-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(17, 17, 17, 0.2) 0%, rgba(17, 17, 17, 0.05) 100%);
      opacity: 1;
      transition: opacity 0.3s ease;
      pointer-events: none;
      z-index: 10;
    }

    .project-card-link:hover .image-overlay {
      opacity: 0;
    }

    .project-card-link.cursor-default {
      cursor: default;
    }

    .project-info {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      font-size: 0.875rem;
      font-weight: 400;
      color: #fff;
      padding-top: 0.25rem;
    }

    .project-title {
      text-align: left;
    }

    .project-date {
      text-align: right;
      opacity: 0.7;
    }
  </style>

  <script is:inline>
    function setupVideoHover() {
      const containers = document.querySelectorAll(".project-image-container");

      containers.forEach((container) => {
        const video = container.querySelector("video");
        if (video) {
          // Check if already attached to avoid duplicates
          if (container.dataset.hasHoverListener) return;
          container.dataset.hasHoverListener = "true";

          // Ensure video is paused initially
          video.pause();

          container.addEventListener("mouseenter", () => {
            video.muted = true; // Ensure muted for autoplay policy
            const playPromise = video.play();
            if (playPromise !== undefined) {
              playPromise.catch((e) => console.debug("Video play interrupted", e));
            }
          });

          container.addEventListener("mouseleave", () => {
            video.pause();
          });
        }
      });
    }

    // Run on initial load
    document.addEventListener("DOMContentLoaded", setupVideoHover);
    // Run on view transitions navigation
    document.addEventListener("astro:page-load", setupVideoHover);
  </script>
</Base>
