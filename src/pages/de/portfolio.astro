---
import Base from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import PortfolioAnimation from "@/components/PortfolioAnimation";
import ShainLogo from "@/components/ShainLogo";
import SmoothScroll from "@/components/SmoothScroll";
import LottiePlayer from "@/components/LottiePlayer";

const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((p) => p.data.showInPortfolio === true)
  .map((p) => ({
    slug: p.slug,
    url: `/de/projects/${p.slug}`,
    title: p.data.title,
    cover: p.data.cover,
    coverAlt: p.data.coverAlt ?? p.data.title,
    year: p.data.year,
    featured: p.data.featured,
  }))
  .sort((a, b) => {
    const yearA = a.year ?? 0;
    const yearB = b.year ?? 0;
    if (yearA !== yearB) return yearB - yearA;
    const featuredA = a.featured ? 1 : 0;
    const featuredB = b.featured ? 1 : 0;
    if (featuredA !== featuredB) return featuredB - featuredA;
    return 0;
  });
---

<Base title="Shain — Portfolio" lang="de" showFooter={true} footerMode="reveal" wrapperClass="bg-[#111]">
  <SmoothScroll client:load />
  <main class="portfolio-container">
    <PortfolioAnimation client:load>
      <header class="portfolio-header">
        <div class="logo-container shain-logo-wrapper">
          <ShainLogo />
        </div>

        <div class="portfolio-content-wrapper">
          <div class="portfolio-intro portfolio-intro-content">
            <div class="intro-link">
              <a href="/de" class="studio-link">Das Studio <span class="arrow">→</span></a>
            </div>
            <div class="intro-text">
              <h1>
                <span class="block w-full text-right"
                  >UI/UX-Designer, der Komplexität in klare Bildschirme verwandelt —</span
                >
                <span class="block w-full text-left"
                  >von der Konzeption bis zur entwicklungsfertigen Übergabe, mit hochwertigem 3D & Motion, um Schlüsselmomente zu steigern, ohne die Usability zu opfern.</span
                >
              </h1>
            </div>
          </div>

          <div class="projects-grid projects-grid-content">
            {
              projects.map((project, index) => {
                // Pattern: 4 cols, 2 cols, 2 cols, 4 cols (repeating)
                const isBig = index % 4 === 0 || index % 4 === 3;
                const isPriority = index < 2;
                const isLottie = project.cover.endsWith(".json");

                return (
                  <div class={`project-item ${isBig ? "span-4" : "span-2"}`}>
                    <a href={project.url} class="project-card-link">
                      <div class="project-image-container">
                        {isLottie ? (
                          <LottiePlayer 
                            src={project.cover} 
                            className="project-image" 
                            client:visible 
                          />
                        ) : (
                          <img 
                            src={project.cover} 
                            alt={project.coverAlt} 
                            class="project-image" 
                            loading={isPriority ? "eager" : "lazy"}
                            fetchpriority={isPriority ? "high" : "auto"}
                          />
                        )}
                      </div>
                      <div class="project-info">
                        <span class="project-title">{project.title}</span>
                        <span class="project-date">{project.year}</span>
                      </div>
                    </a>
                  </div>
                );
              })
            }
          </div>
        </div>
      </header>
    </PortfolioAnimation>
  </main>

  <style>
    :global(body) {
      --nav-text: #fff;
    }

    :global(#glass-overlay) {
      --nav-text: #000;
    }

    .portfolio-container {
      padding: 0;
      background-color: #111; /* Dark background as per reference image */
      color: #fff;
      min-height: 100vh;
    }

    .portfolio-header {
      padding: var(--space-4);
      margin-bottom: var(--space-16);
      position: relative;
      /* Ensure header takes up space but allows things to be sticky if we wanted pure CSS sticky, 
       but we are using GSAP for parallax so relative is fine */
    }

    /* We need a wrapper to act as the scroll container if we were doing custom scrolling, 
     but standard body scroll works with GSAP ScrollTrigger */

    .logo-container {
      width: 100%;
      margin-top: 16px;
      margin-bottom: var(--space-8);
      /* padding: 0 16px; Removed to align with projects */
      color: #fff;
      box-sizing: border-box;
      /* Will be animated by GSAP */
      position: relative;
      z-index: 1;
    }

    .portfolio-content-wrapper {
      position: relative;
      z-index: 10;
      background-color: #111;
      margin-top: 4rem;
    }

    .portfolio-intro {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-4);
      /* Padding 32px top, 48px bottom (increased from 16px), 16px sides */
      padding: 32px 16px 48px 16px;
      position: relative;
      background-color: #111; /* Ensure background color is set */
      z-index: 10;
      margin-bottom: -1px; /* Ensure overlap */
    }

    /* 
     For the specific effect requested: "scrolls over the title SHAIN".
     We can make the logo container sticky or fixed, and let the rest scroll over it.
     But since we are using GSAP in the wrapper component, let's let GSAP handle the movement.
     We just need to ensure z-indices are correct:
     Logo: lower z-index
     Intro & Grid: higher z-index and have background color.
  */

    @media (min-width: 768px) {
      .portfolio-intro {
        display: block;
        position: relative;
      }

      .intro-link {
        position: absolute;
        top: 32px; /* Align with container top padding */
        left: 0;
        width: 25%;
        /* Ensure it aligns with the padding of the container */
        padding-left: 16px; /* Align with container side padding */
      }

      .intro-text {
        width: 100%;
      }
    }

    /* Mobile styles for intro layout */
    @media (max-width: 767px) {
      .portfolio-intro {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding: 24px 16px 32px 16px;
        padding-top: max(24px, env(safe-area-inset-top));
      }

      .intro-link {
        position: relative;
        width: 100%;
        margin-bottom: var(--space-2);
      }

      .intro-text {
        width: 100%;
      }

      /* On mobile, align text left normally, no forced right/left split if it looks weird */
      .intro-text h1 span.text-right {
        text-align: left;
      }
    }

    .studio-link {
      color: #fff;
      text-decoration: underline;
      font-size: 1.25rem;
      text-underline-offset: 4px;
    }

    .studio-link:hover {
      opacity: 0.8;
    }

    .intro-text h1 {
      /* Fluid typography: 
         Min font: 1.5rem (24px) at 320px viewport
         Max font: 3rem (48px) at 1920px viewport
         Slope: (48 - 24) / (1920 - 320) = 24 / 1600 = 0.015
         y-intercept: 24 - (0.015 * 320) = 19.2
         Equation: 19.2px + 1.5vw
      */
      font-size: clamp(1.5rem, 1.2rem + 1.5vw, 3rem);
      line-height: 1.1;
      font-weight: 500;
      max-width: 100%;
      margin: 0;
    }

    @media (min-width: 768px) {
      .intro-text h1 {
        /* text-indent: 25vw; Removed as we are using block spans now */
      }
    }

    .projects-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-4);
      /* No top padding so background merges with intro */
      padding: 0 16px max(var(--space-4), env(safe-area-inset-bottom)) 16px;
      position: relative;
      z-index: 10;
      background-color: #111; /* Cover the parallax logo */
      min-height: 100vh; /* Ensure it covers even if few projects */
      margin-top: -1px; /* Ensure overlap */
    }

    @media (min-width: 768px) {
      .projects-grid {
        grid-template-columns: repeat(6, 1fr);
        gap: 1rem;
      }
    }

    .project-item {
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .project-card-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .project-image-container {
      width: 100%;
      background-color: #e5e5e5;
      border-radius: 0px;
      overflow: hidden;
      margin-bottom: 0.5rem;
      aspect-ratio: 16/9;
    }

    .span-4 .project-image-container {
      aspect-ratio: 16/9;
    }

    .project-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      opacity: 0.9;
      transition: opacity 0.3s ease;
    }

    .project-card-link:hover .project-image {
      opacity: 1;
    }

    .project-info {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      font-size: 0.875rem;
      font-weight: 400;
      color: #fff;
      padding-top: 0.25rem;
    }

    .project-title {
      text-align: left;
    }

    .project-date {
      text-align: right;
      opacity: 0.7;
    }

    @media (min-width: 768px) {
      .span-4 {
        grid-column: span 4;
      }
      .span-2 {
        grid-column: span 2;
      }
    }

    @media (max-width: 767px) {
      .intro-text h1 span {
        text-align: left !important;
      }

      .span-4,
      .span-2 {
        grid-column: span 1;
      }
    }
  </style>
</Base>
