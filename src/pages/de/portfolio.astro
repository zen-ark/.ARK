---
import Base from "@/layouts/Base.astro";
import { loadProjects, type ProjectListItem } from "@/lib/projects";
import PortfolioAnimation from "@/components/PortfolioAnimation";
import ShainLogo from "@/components/ShainLogo";
import SmoothScroll from "@/components/SmoothScroll";
import LottiePlayer from "@/components/LottiePlayer";
import PreviousExperienceStrip from "@/components/PreviousExperienceStrip.astro";

const allProjects = await loadProjects({ mode: "hiring" });
// Keep DE URLs pointing at the German route tree without touching the
// slugs or breaking inbound links.
const projects: ProjectListItem[] = allProjects.map((p) => ({
  ...p,
  url: `/de/projects/${p.slug}`,
}));

const selectedWork: ProjectListItem[] = projects.filter((p) => p.category === "selected");
const explorations: ProjectListItem[] = projects.filter((p) => p.category === "explorations");
const workInProgress: ProjectListItem[] = projects.filter(
  (p) => p.category === "wip" || p.workInProgress
);

const sections: Array<{
  id: string;
  eyebrow: string;
  heading: string;
  description?: string;
  items: ProjectListItem[];
}> = [
  {
    id: "work",
    eyebrow: "01 — Kundenarbeit",
    heading: "Ausgewählte Arbeiten",
    description:
      "Mandate, in denen UX-Strategie, visuelle Führung und Dev-Übergabe termingerecht in Produktion gegangen sind.",
    items: selectedWork,
  },
  {
    id: "explorations",
    eyebrow: "02 — Studio & R&D",
    heading: "Explorationen",
    description:
      "Eigenständige Arbeiten: das .ARK Studio-System und ein 8-jähriges 3D-Archiv. Hier werden neue Ideen erprobt, bevor sie in Kundenprojekte einfliessen.",
    items: explorations,
  },
  {
    id: "wip",
    eyebrow: "03 — In Arbeit",
    heading: "Work in Progress",
    description: "Aktuell im Aufbau — bald mehr zu sehen.",
    items: workInProgress,
  },
].filter((section) => section.items.length > 0);
---

<Base
  title="Shain — Portfolio"
  lang="de"
  showFooter={true}
  footerMode="reveal"
  wrapperClass="bg-[#111]"
>
  <SmoothScroll client:load />
  <main class="portfolio-container">
    <PortfolioAnimation client:load>
      <header class="portfolio-header">
        <div class="logo-container shain-logo-wrapper">
          <ShainLogo />
        </div>

        <div class="portfolio-content-wrapper">
          <div class="portfolio-intro portfolio-intro-content">
            <div class="intro-link">
              <a href="/de" class="studio-link">Das Studio <span class="arrow">→</span></a>
            </div>
            <div class="intro-text">
              <h1>
                <span class="intro-line-primary block w-full"
                  >UI/UX-Designer, der Komplexität in klare Bildschirme verwandelt&nbsp;—</span
                >
                <span class="intro-line-secondary block w-full"
                  >von der Konzeption bis zur entwicklungsfertigen Übergabe, mit hochwertigem 3D &
                  Motion, um Schlüsselmomente zu steigern, ohne die Usability zu opfern.</span
                >
              </h1>
            </div>
          </div>

          <div class="portfolio-strips">
            <PreviousExperienceStrip locale="de" />
          </div>

          <div class="projects-sections projects-grid-content">
            {
              sections.map((section, sectionIndex) => (
                <section
                  id={section.id}
                  class={`projects-section projects-section--${section.id}`}
                  aria-labelledby={`section-${section.id}-heading`}
                >
                  <header class="projects-section-header">
                    <span class="projects-section-eyebrow">{section.eyebrow}</span>
                    <h2 id={`section-${section.id}-heading`} class="projects-section-heading">
                      {section.heading}
                    </h2>
                    {section.description && (
                      <p class="projects-section-description">{section.description}</p>
                    )}
                  </header>

                  <div class="projects-grid">
                    {section.items.map((project, itemIndex) => {
                      const globalIndex = sectionIndex * 10 + itemIndex;
                      const gridClass = "span-6";
                      const isPriority = sectionIndex === 0 && itemIndex < 2;
                      const isLottie = project.cover.endsWith(".json");
                      const isVideo = project.cover.match(/\.(mp4|webm|mov)$/i);
                      const needsDarkBg =
                        project.slug === "trauffer" || project.slug === "movieworld-spiez";
                      const isWIP = project.workInProgress || project.category === "wip";

                      const metaTokens = [project.role, project.context, project.year]
                        .filter(Boolean)
                        .map((t) => String(t));

                      const mediaBlock = (
                        <div class="project-image-container relative">
                          {isWIP && <div class="wip-banner">Work in Progress</div>}
                          {isLottie ? (
                            <LottiePlayer
                              src={project.cover.replace(/ /g, "%20")}
                              className="project-image"
                              loop={true}
                              client:visible
                              backgroundColor={needsDarkBg ? "#111111" : undefined}
                              isFirst={globalIndex === 0}
                            />
                          ) : isVideo ? (
                            <video
                              src={project.cover.replace(/ /g, "%20")}
                              class={`project-image ${isWIP ? "opacity-50" : ""}`}
                              muted
                              loop
                              playsinline
                              preload="metadata"
                            />
                          ) : (
                            <img
                              src={project.cover.replace(/ /g, "%20")}
                              alt={project.coverAlt}
                              class={`project-image ${isWIP ? "opacity-50" : ""}`}
                              loading={isPriority ? "eager" : "lazy"}
                              fetchpriority={isPriority ? "high" : "auto"}
                            />
                          )}
                          {!isWIP && <div class="image-overlay" />}
                        </div>
                      );

                      const infoFields = (
                        <div class="project-item-content">
                          <div class="project-info-top">
                            <span class="project-title">{project.title}</span>
                            <span class="project-date">{project.year}</span>
                          </div>
                          {project.subtitle && (
                            <span class="project-subtitle">{project.subtitle}</span>
                          )}
                          {metaTokens.length > 0 && (
                            <span class="project-meta">{metaTokens.join(" · ")}</span>
                          )}
                          {project.summaryCard && (
                            <p class="project-summary">{project.summaryCard}</p>
                          )}
                          {project.stack && project.stack.length > 0 && (
                            <ul class="project-stack" aria-label="Stack">
                              {project.stack.slice(0, 3).map((tag) => (
                                <li class="project-stack-tag">{tag}</li>
                              ))}
                            </ul>
                          )}
                        </div>
                      );

                      return (
                        <div
                          class={`project-item ${gridClass}`}
                          data-index={globalIndex}
                        >
                          {isWIP ? (
                            <div class="project-card project-card--wip">
                              <div class="project-card-media-link cursor-default">{mediaBlock}</div>
                              <div class="project-info">{infoFields}</div>
                            </div>
                          ) : (
                            <div class="project-card">
                              <a href={project.url} class="project-card-media-link">
                                {mediaBlock}
                              </a>
                              <div class="project-info">
                                <a href={project.url} class="project-info-link">
                                  {infoFields}
                                </a>
                              </div>
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>
                </section>
              ))
            }
          </div>
        </div>
      </header>
    </PortfolioAnimation>
  </main>

  <style>
    :global(body) {
      --nav-text: #fff;
    }

    :global(#glass-overlay) {
      --nav-text: #000;
    }

    .portfolio-container {
      padding: 0;
      background-color: #111; /* Dark background as per reference image */
      color: #fff;
      min-height: 100vh;
    }

    .portfolio-header {
      padding: var(--space-4);
      margin-bottom: var(--space-16);
      position: relative;
      overflow-x: clip;
      /* Ensure header takes up space but allows things to be sticky if we wanted pure CSS sticky, 
       but we are using GSAP for parallax so relative is fine */
    }

    /* We need a wrapper to act as the scroll container if we were doing custom scrolling, 
     but standard body scroll works with GSAP ScrollTrigger */

    .logo-container {
      width: 100%;
      margin-top: 16px;
      margin-bottom: var(--space-8);
      /* padding: 0 16px; Removed to align with projects */
      color: #fff;
      box-sizing: border-box;
      /* Will be animated by GSAP */
      position: relative;
      z-index: 1;
    }

    /* Keep the SHAIN wordmark inside the mobile viewport with clear
     * breathing room on both sides and below the fixed MENU pill. */
    @media (max-width: 480px) {
      .portfolio-header {
        padding: calc(var(--header-pill-height, 52px) + 24px) 12px 0;
      }

      .logo-container {
        width: 100%;
        max-width: calc(100vw - 24px);
        margin-top: 0;
        margin-inline: auto;
        padding-inline: 4px;
        overflow-x: clip;
      }

      .logo-container :global(.shain-logo),
      .logo-container :global(svg) {
        display: block;
        width: 100%;
        max-width: 100%;
        height: auto;
      }
    }

    .portfolio-content-wrapper {
      position: relative;
      z-index: 10;
      background-color: #111;
      margin-top: 4rem;
    }

    .portfolio-strips {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 0 max(32px, env(safe-area-inset-left)) 1.5rem max(32px, env(safe-area-inset-right));
      background-color: #111;
      position: relative;
      z-index: 10;
    }

    @media (min-width: 768px) {
      .portfolio-strips {
        padding: 0 max(32px, env(safe-area-inset-left)) 2rem max(32px, env(safe-area-inset-right));
        gap: 1rem;
      }
    }

    /*
     * Pre-hide animated targets at first paint (no React wrapper dependency).
     * Uses visibility + opacity so GSAP autoAlpha reveals them atomically.
     */
    .portfolio-intro-content,
    .projects-grid-content .project-item,
    .projects-grid-content .projects-section-header {
      visibility: hidden;
      opacity: 0;
      transform: translateY(30px);
    }

    .portfolio-strips :global(.previously-strip) {
      visibility: hidden;
      opacity: 0;
      transform: translateX(-40px);
    }

    .shain-logo-wrapper :global(.shain-logo .letter) {
      visibility: hidden;
      opacity: 0;
    }

    .portfolio-intro {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding: 32px max(32px, env(safe-area-inset-left)) 48px max(32px, env(safe-area-inset-right));
      position: relative;
      background-color: #111; /* Ensure background color is set */
      z-index: 10;
      margin-bottom: -1px; /* Ensure overlap */
    }

    /* 
     For the specific effect requested: "scrolls over the title SHAIN".
     We can make the logo container sticky or fixed, and let the rest scroll over it.
     But since we are using GSAP in the wrapper component, let's let GSAP handle the movement.
     We just need to ensure z-indices are correct:
     Logo: lower z-index
     Intro & Grid: higher z-index and have background color.
  */

    @media (min-width: 768px) {
      .portfolio-intro {
        display: grid;
        grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
        column-gap: clamp(1rem, 2.5vw, 2rem);
        row-gap: 0;
        align-items: start;
      }

      .intro-link {
        position: static;
        width: auto;
        padding-top: 0.35rem;
      }

      .intro-text {
        width: 100%;
        min-width: 0;
      }

      .intro-line-primary,
      .intro-line-secondary {
        text-align: left;
      }
    }

    /* Mobile styles for intro layout */
    @media (max-width: 767px) {
      .portfolio-intro {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding: 24px max(32px, env(safe-area-inset-left)) 32px max(32px, env(safe-area-inset-right));
        padding-top: max(24px, env(safe-area-inset-top));
      }

      .intro-link {
        position: relative;
        width: 100%;
        margin-bottom: var(--space-2);
      }

      .intro-text {
        width: 100%;
      }

      .intro-line-primary,
      .intro-line-secondary {
        text-align: left;
      }
    }

    .intro-link {
      text-align: left;
    }

    .studio-link {
      color: #fff;
      text-decoration: underline;
      font-size: 1.25rem;
      text-underline-offset: 4px;
      text-align: left;
    }

    .studio-link:hover {
      opacity: 0.8;
    }

    .intro-text h1 {
      /* Fluid typography: 
         Min font: 1.5rem (24px) at 320px viewport
         Max font: 3rem (48px) at 1920px viewport
         Slope: (48 - 24) / (1920 - 320) = 24 / 1600 = 0.015
         y-intercept: 24 - (0.015 * 320) = 19.2
         Equation: 19.2px + 1.5vw
      */
      font-size: clamp(1.5rem, 1.2rem + 1.5vw, 3rem);
      line-height: 1.05;
      font-weight: 500;
      max-width: 100%;
      margin: 0;
    }

    .projects-sections {
      position: relative;
      z-index: 10;
      background-color: #111;
      min-height: 100vh;
      margin-top: -1px;
    }

    .projects-section {
      scroll-margin-top: 96px;
    }

    .projects-section + .projects-section {
      padding-top: 4rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .projects-section-header {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding: 1.5rem max(32px, env(safe-area-inset-left)) 1.5rem max(32px, env(safe-area-inset-right));
      max-width: 62ch;
    }

    .projects-section-eyebrow {
      font-family: "JetBrains Mono", monospace;
      font-size: 0.75rem;
      font-weight: 400;
      line-height: 1.2;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.5);
    }

    .projects-section-heading {
      font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
      font-weight: 500;
      line-height: 1.05;
      margin: 0;
      color: #fff;
    }

    .projects-section-description {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.35;
      color: rgba(255, 255, 255, 0.65);
    }

    @media (min-width: 768px) {
      .projects-section-header {
        padding: 2rem max(32px, env(safe-area-inset-left)) 2rem max(32px, env(safe-area-inset-right));
      }
    }

    .projects-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(2.75rem, 6.5vw, 3.75rem);
      padding: 0 max(32px, env(safe-area-inset-left)) 3rem max(32px, env(safe-area-inset-right));
      position: relative;
      z-index: 10;
      background-color: #111;
      margin-top: -1px;
    }

    .projects-section--wip .projects-grid {
      padding-bottom: 2rem;
    }

    @media (min-width: 768px) {
      .projects-grid {
        grid-template-columns: repeat(12, 1fr);
        column-gap: 2rem;
        row-gap: clamp(5.25rem, 10vw, 7rem);
        padding: 0 max(32px, env(safe-area-inset-left)) 4rem max(32px, env(safe-area-inset-right));
      }

      .span-6 {
        grid-column: span 6;
      }

      .span-7 {
        grid-column: span 7;
      }

      .span-5 {
        grid-column: span 5;
      }

      .span-7 .project-image-container,
      .span-5 .project-image-container {
        aspect-ratio: 16/9;
      }

      .projects-grid .project-item:nth-child(even) .project-item-content {
        margin-top: 10vh;
      }
    }

    @media (max-width: 767px) {
      .span-6,
      .span-4,
      .span-3,
      .span-2 {
        grid-column: span 1;
      }
    }

    /* .project-item is now applied to the RevealOnScroll wrapper */
    .project-item {
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .project-card {
      display: block;
    }

    .project-card-media-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .project-card--wip .project-card-media-link {
      cursor: default;
    }

    .project-info-link {
      display: flex;
      flex-direction: column;
      gap: 0;
      text-decoration: none;
      color: inherit;
    }

    .project-image-container {
      width: 100%;
      background-color: #111; /* Match page background to prevent flickering */
      border-radius: 0px;
      overflow: hidden;
      margin-bottom: 0.3rem;
      aspect-ratio: 16/9;
      transform: translateZ(0); /* Fix for Safari flickering */
    }

    .span-6 .project-image-container {
      aspect-ratio: 16/9;
    }

    .project-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      opacity: 1; /* Fully visible by default */
    }

    .wip-banner {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      padding: 0.5rem 1rem;
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #fff;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      z-index: 20;
      border-radius: 9999px;
      pointer-events: none;
    }

    .image-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(17, 17, 17, 0.2) 0%, rgba(17, 17, 17, 0.05) 100%);
      opacity: 1;
      transition: opacity 0.3s ease;
      pointer-events: none;
      z-index: 10;
    }

    .project-card:hover .image-overlay {
      opacity: 0;
    }

    .project-info {
      display: flex;
      flex-direction: column;
      gap: 0;
      font-size: 0.875rem;
      font-weight: 400;
      color: #fff;
      padding-top: 0.2rem;
    }

    .project-info-top + .project-subtitle {
      margin-top: 0.12rem;
    }

    .project-info-top + .project-meta {
      margin-top: 0.55rem;
    }

    .project-subtitle + .project-meta {
      margin-top: 0.3rem;
    }

    .project-meta + .project-summary {
      margin-top: 0.55rem;
    }

    .project-info-top + .project-summary {
      margin-top: 0.55rem;
    }

    .project-subtitle + .project-summary {
      margin-top: 0.55rem;
    }

    .project-summary + .project-stack {
      margin-top: 0.75rem;
    }

    .project-info-top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }

    .project-title {
      text-align: left;
      font-weight: 500;
    }

    .project-date {
      text-align: right;
      opacity: 0.7;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.8125rem;
    }

    .project-subtitle {
      font-size: 0.8125rem;
      color: rgba(255, 255, 255, 0.72);
      letter-spacing: 0.01em;
    }

    .project-meta {
      font-family: "JetBrains Mono", monospace;
      font-size: 0.7rem;
      font-weight: 400;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.5);
    }

    .project-summary {
      margin: 0;
      font-size: 0.875rem;
      line-height: 1.45;
      color: rgba(255, 255, 255, 0.68);
      max-width: 58ch;
    }

    .project-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .project-stack-tag {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.7rem;
      letter-spacing: 0.02em;
      line-height: 1;
      padding: 0.2rem 0.55rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 9999px;
      color: rgba(255, 255, 255, 0.75);
      background: rgba(255, 255, 255, 0.03);
    }
  </style>

  <script is:inline>
    function setupVideoHover() {
      const containers = document.querySelectorAll(".project-image-container");

      containers.forEach((container) => {
        const video = container.querySelector("video");
        if (video) {
          // Check if already attached to avoid duplicates
          if (container.dataset.hasHoverListener) return;
          container.dataset.hasHoverListener = "true";

          // Ensure video is paused initially
          video.pause();

          container.addEventListener("mouseenter", () => {
            video.muted = true; // Ensure muted for autoplay policy
            const playPromise = video.play();
            if (playPromise !== undefined) {
              playPromise.catch((e) => console.debug("Video play interrupted", e));
            }
          });

          container.addEventListener("mouseleave", () => {
            video.pause();
          });
        }
      });
    }

    // Run on initial load
    document.addEventListener("DOMContentLoaded", setupVideoHover);
    // Run on view transitions navigation
    document.addEventListener("astro:page-load", setupVideoHover);
  </script>
</Base>
