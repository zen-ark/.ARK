---
import { getCollection } from "astro:content";

interface Props {
  nextProject?: {
    slug: string;
    title: string;
    cover?: string;
  };
  currentSlug?: string;
}

const { nextProject: propNextProject, currentSlug } = Astro.props;

let nextProject = propNextProject;

if (!nextProject && currentSlug) {
  const projects = await getCollection("projects");
  const index = projects.findIndex(p => p.slug === currentSlug);
  if (index !== -1 && index < projects.length - 1) {
    const next = projects[index + 1];
    nextProject = {
      slug: next.slug,
      title: next.data.title,
      cover: next.data.cover
    };
  }
}
---

<section class="w-full py-24 md:py-32 bg-transparent border-t border-white/5">
  <div class="max-w-4xl mx-auto px-4 md:px-6 text-center mb-24">
    <h2 class="text-3xl md:text-5xl font-bold text-white mb-8 tracking-tight">
      The Results
    </h2>
    <div class="text-xl md:text-2xl text-white/70 leading-relaxed font-light">
      <slot>
        The result is a unified, scalable digital presence that honors Trauffer’s tradition while providing a modern, frictionless user journey. By leading direct client meetings and utilizing a component-based workflow, we achieved a 'first-time-right' delivery that exceeded stakeholder expectations.
      </slot>
    </div>
  </div>

  {nextProject && (
    <div class="w-full max-w-7xl mx-auto px-4 md:px-6">
      <div class="border-t border-white/10 pt-12">
        <p class="text-sm font-mono uppercase tracking-wider text-white/40 mb-6">Next Project</p>
        <a 
          href={`/projects/${nextProject.slug}`}
          class="group block relative w-full aspect-[21/9] overflow-hidden rounded-xl bg-white/5"
        >
          {nextProject.cover && (
            <img 
              src={nextProject.cover} 
              alt={nextProject.title}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 opacity-80 group-hover:opacity-100"
            />
          )}
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors duration-500"></div>
          <div class="absolute bottom-0 left-0 p-8 md:p-12">
            <h3 class="text-4xl md:text-6xl font-bold text-white mb-2 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 ease-out">
              {nextProject.title}
            </h3>
            <span class="inline-flex items-center gap-2 text-white/80 text-lg translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 delay-75 ease-out">
              View Case Study →
            </span>
          </div>
        </a>
      </div>
    </div>
  )}
</section>
