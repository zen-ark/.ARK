---
import { loadProjects } from "@/lib/projects";
import LottiePlayer from "../LottiePlayer";

interface OutcomeBullet {
  label: string;
  text: string;
}

interface Props {
  nextProject?: {
    slug: string;
    title: string;
    cover?: string;
  };
  currentSlug?: string;
  outcome?: string;
  outcomeBullets?: OutcomeBullet[];
  heading?: string;
}

const {
  nextProject: propNextProject,
  currentSlug,
  outcome,
  outcomeBullets,
  heading,
} = Astro.props;

let nextProject = propNextProject;

if (!nextProject && currentSlug) {
  // Use loadProjects with mode: 'portfolio' to match the landing page logic
  const projects = (await loadProjects({ mode: "portfolio" })).filter(
    (p) => p.slug !== "dropin-costa-rica"
  );
  const index = projects.findIndex((p) => p.slug === currentSlug);

  if (index !== -1 && projects.length > 0) {
    const nextIndex = (index + 1) % projects.length;
    const next = projects[nextIndex];

    // Ensure we don't link to the current project if it's the only one
    if (next.slug !== currentSlug) {
      nextProject = {
        slug: next.slug,
        title: next.title,
        cover: next.cover,
      };
    }
  }
}

const isLottie = nextProject?.cover?.endsWith(".json");
const isVideo = nextProject?.cover?.endsWith(".mp4") || nextProject?.cover?.endsWith(".webm");
const needsDarkBg = nextProject?.slug === "trauffer" || nextProject?.slug === "movieworld-spiez";
---

<section class="w-full py-24 md:py-32 bg-transparent border-t border-white/5">
  <div class="max-w-5xl mx-auto px-4 md:px-6 mb-24">
    <h2
      class="text-3xl md:text-5xl font-bold text-white mb-10 tracking-tight text-center"
    >
      {heading || "The Results"}
    </h2>

    {
      outcome && (
        <p class="text-xl md:text-2xl text-white/85 leading-relaxed font-light max-w-3xl mx-auto text-center mb-12">
          {outcome}
        </p>
      )
    }

    {
      outcomeBullets && outcomeBullets.length > 0 && (
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 list-none p-0 m-0">
          {outcomeBullets.map((bullet) => (
            <li class="flex flex-col gap-3 p-6 rounded-2xl border border-white/10 bg-white/[0.02]">
              <span class="text-xs font-mono uppercase tracking-wider text-white/45">
                {bullet.label}
              </span>
              <p class="text-base md:text-lg text-white/80 leading-relaxed m-0">
                {bullet.text}
              </p>
            </li>
          ))}
        </ul>
      )
    }

    {
      !outcome && (!outcomeBullets || outcomeBullets.length === 0) && (
        <div class="text-xl md:text-2xl text-white/70 leading-relaxed font-light text-center">
          <slot>
            The result is a unified, scalable digital presence that honors Trauffer’s
            tradition while providing a modern, frictionless user journey. By leading direct
            client meetings and utilizing a component-based workflow, we achieved a
            'first-time-right' delivery that exceeded stakeholder expectations.
          </slot>
        </div>
      )
    }
  </div>

  {
    nextProject && (
      <div class="w-full max-w-7xl mx-auto px-4 md:px-6">
        <div class="border-t border-white/10 pt-12">
          <p class="text-sm font-mono uppercase tracking-wider text-white/40 mb-6">Next Project</p>
          <a
            href={`/portfolio/projects/${nextProject.slug}`}
            class="group block relative w-full aspect-[21/9] overflow-hidden rounded-xl bg-white/5"
          >
            {nextProject.cover &&
              (isLottie ? (
                <LottiePlayer
                  client:load
                  src={nextProject.cover}
                  className="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loop={true}
                  backgroundColor={needsDarkBg ? "#111111" : undefined}
                />
              ) : isVideo ? (
                <video
                  src={nextProject.cover}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 opacity-80 group-hover:opacity-100"
                  autoplay
                  muted
                  loop
                  playsinline
                />
              ) : (
                <img
                  src={nextProject.cover}
                  alt={nextProject.title}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 opacity-80 group-hover:opacity-100"
                />
              ))}
            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors duration-500 pointer-events-none" />
            <div class="absolute bottom-0 left-0 p-8 md:p-12 pointer-events-none">
              <h3 class="text-4xl md:text-6xl font-bold text-white mb-2 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 ease-out">
                {nextProject.title}
              </h3>
              <span class="inline-flex items-center gap-2 text-white/80 text-lg translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 delay-75 ease-out">
                View Case Study →
              </span>
            </div>
          </a>
        </div>
      </div>
    )
  }
</section>
