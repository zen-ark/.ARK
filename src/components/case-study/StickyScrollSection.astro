---
import RevealOnScroll from "../RevealOnScroll";

interface Props {
  title: string;
  heading: string;
}

const { title, heading } = Astro.props;
---

<section class="w-full max-w-case mx-auto px-4 md:px-6 py-12 md:py-24">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16">
    <!-- Sticky Left Column -->
    <div class="md:sticky md:top-32 h-fit self-start">
      <RevealOnScroll client:visible>
        <span
          class="text-sm md:text-base font-mono uppercase tracking-wider text-white/50 mb-4 block"
        >
          {title}
        </span>
        <h3 class="text-3xl md:text-4xl font-bold text-white mb-6">
          {heading}
        </h3>
        <div class="text-lg text-white/80 leading-relaxed font-light">
          <slot />
        </div>
      </RevealOnScroll>
    </div>

    <!-- Scrolling Right Column -->
    <div class="space-y-8 md:space-y-16">
      <slot name="visuals" />
    </div>
  </div>
</section>
