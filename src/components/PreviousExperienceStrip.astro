---
interface Props {
  locale?: "en" | "de";
}

const { locale = "en" } = Astro.props;

const label = locale === "de" ? "Zuvor bei" : "Previously at";

const employers: Array<{
  name: string;
  display: string;
  href: string;
  className: string;
  accent?: "dot";
}> = [
  {
    name: "Swisscom",
    display: "Swisscom",
    href: "https://www.swisscom.ch/",
    className: "logo-swisscom",
  },
  {
    name: "Cleverclip",
    display: "cleverclip",
    href: "https://cleverclip.ch/",
    className: "logo-cleverclip",
  },
  {
    name: "Comvation",
    display: "COMVATION",
    href: "https://www.comvation.com/",
    className: "logo-comvation",
    accent: "dot",
  },
  {
    name: "Maxomedia",
    display: "maxomedia",
    href: "https://www.maxomedia.ch/",
    className: "logo-maxomedia",
  },
];
---

<aside class="previously-strip" aria-label={label}>
  <span class="previously-strip-label">{label}</span>
  <ul class="previously-strip-list">
    {
      employers.map((e) => (
        <li class="previously-strip-item">
          <a
            class={`previously-strip-logo ${e.className}`}
            href={e.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={e.name}
          >
            <span class="previously-strip-logo-text">{e.display}</span>
            {e.accent === "dot" && <span class="previously-strip-logo-dot" aria-hidden="true" />}
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .previously-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    padding: 1rem 1rem 1.25rem 1rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .previously-strip-label {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    white-space: nowrap;
  }

  .previously-strip-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .previously-strip-item {
    display: inline-flex;
    align-items: center;
  }

  .previously-strip-logo {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    line-height: 1;
    transition:
      color 200ms ease,
      opacity 200ms ease;
  }

  .previously-strip-logo:hover,
  .previously-strip-logo:focus-visible {
    color: rgba(255, 255, 255, 0.98);
    outline: none;
  }

  .previously-strip-logo:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .previously-strip-logo-text {
    font-family: "Geist", "Inter", system-ui, sans-serif;
    font-size: 1.25rem;
  }

  /* Per-brand typographic treatment (monochrome wordmarks).
   * Each brand gets a distinct weight / case / tracking so the row
   * reads as a strip of logos rather than a list of words. */
  .logo-swisscom .previously-strip-logo-text {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .logo-cleverclip .previously-strip-logo-text {
    font-weight: 500;
    letter-spacing: -0.005em;
    text-transform: lowercase;
  }

  .logo-comvation .previously-strip-logo-text {
    font-weight: 400;
    letter-spacing: 0.14em;
    font-size: 1.05rem;
  }

  .logo-comvation .previously-strip-logo-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: currentColor;
    margin-left: 3px;
    align-self: flex-end;
    margin-bottom: 2px;
    opacity: 0.9;
  }

  .logo-maxomedia .previously-strip-logo-text {
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: lowercase;
  }

  @media (max-width: 600px) {
    .previously-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.75rem 0.5rem 1rem 0.5rem;
    }

    .previously-strip-list {
      gap: 0.75rem 1.75rem;
    }

    .previously-strip-logo-text {
      font-size: 1.1rem;
    }

    .logo-comvation .previously-strip-logo-text {
      font-size: 0.95rem;
    }
  }
</style>
