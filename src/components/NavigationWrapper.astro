---
import Navigation from "./Navigation";
import { getCollection } from "astro:content";
import { getMode } from "@/lib/mode";

const { url } = Astro;
const currentPath = url.pathname;
const isGerman = currentPath.startsWith("/de");
const prefix = isGerman ? "/de" : "";

// Detect mode
const mode = getMode(currentPath);

const toHref = (path: string) => {
  if (path === "/") return prefix || "/";
  return `${prefix}${path}`;
};

const agencyLinks = [
  { href: toHref("/"), label: isGerman ? "Startseite" : "Home" },
  { href: "#what-the-ark", label: "WHATS ARK" },
  { href: toHref("/projects"), label: isGerman ? "Projekte" : "Projects" },
  { href: "#how-ark", label: "HOW ARK" },
  { href: "#behind-ark", label: "BEHIND ARK" },
  { href: toHref("/contact"), label: isGerman ? "Kontakt" : "Contact" },
];

const portfolioLinks = [
  { href: toHref("/portfolio"), label: "Home" },
  { href: toHref("/portfolio/about"), label: "About" },
  { href: "/portfolio/resume", label: "CV" },
  { href: toHref("/portfolio/contact"), label: "Contact" },
  { href: toHref("/"), label: "{ Studio }" },
];

const primaryLinks = mode === "hiring" ? portfolioLinks : agencyLinks;

const projects = await getCollection("projects").catch(() => []);

const sortedProjects =
  projects && projects.length
    ? [...projects]
        .sort((a, b) => {
          const da = (a.data as any).date ? new Date((a.data as any).date).getTime() : 0;
          const db = (b.data as any).date ? new Date((b.data as any).date).getTime() : 0;
          return db - da;
        })
        .slice(0, 8)
        .map((p) => ({
          href: `${prefix}/projects/${p.slug}`.replace("//", "/"),
          label: (p.data as any).title || p.slug,
        }))
    : [
        { href: `${prefix}/projects/swiss-fintech`.replace("//", "/"), label: "Swiss Fintech" },
        {
          href: `${prefix}/projects/zen-intelligence`.replace("//", "/"),
          label: "Zen Intelligence",
        },
      ];

// In hiring mode (portfolio), we hide the projects column in the menu
const finalProjects = mode === "hiring" ? [] : sortedProjects;

const talkHref = "mailto:hello@ark.studio.ch";
const logoLines = ["ark", "studio", "ch"];

const isPortfolioProject =
  currentPath.includes("/portfolio/projects/") || currentPath.includes("/de/portfolio/projects/");
const backHref = isPortfolioProject ? toHref("/portfolio") : undefined;
---

<Navigation
  client:load
  projects={finalProjects}
  primaryLinks={primaryLinks}
  talkHref={talkHref}
  logoLines={logoLines}
  activePath={currentPath}
  mode={mode}
  backHref={backHref}
/>
